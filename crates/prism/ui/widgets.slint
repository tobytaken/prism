// Prism's own widget set (ADR 0009). It grows only as screens need it.
//
// Accessibility: every widget declares its `accessible-role`, a label, its value (with
// min/max/step on a spinbox or slider), its checked state (on a switch or checkbox), read-only when
// there's no tuning access, and an `accessible-action-*` for each thing it does. The audit in
// `tests/accessibility.rs` checks this in every fixture state, and each declared action has a
// test that invokes it.
//
// Slint 1.18's `AccessibleRole` has no menu, dialog, popover, tooltip or alert role, so:
// - `Menu` is a `list` with a `list-item` per entry.
// - `Dialog` and `Popover` are a `groupbox` labeled by their title.
// - `Tooltip` isn't a node of its own: its text goes into the owning widget's
//   `accessible-description`.
// - Chart parts (`Grid`, `Series`, `Area`, `LimitLine`, `CurveLine`) are `accessible-role: none`; the track's
//   readout carries the value.

export { StyledText } from "widgets/styled-text.slint";
export { Divider, VerticalDivider } from "widgets/divider.slint";
export { DisclosureMarker } from "widgets/disclosure-marker.slint";
export { PressArea } from "widgets/press-area.slint";
export { ListRow } from "widgets/list-row.slint";
export { LinkButton } from "widgets/link-button.slint";
export { Area, CurveLine, Grid, LimitLine, Series } from "widgets/chart.slint";
export { PopupSurface } from "widgets/popup-surface.slint";
export { Segmented, SegmentView } from "widgets/segmented.slint";
export { Fact } from "widgets/fact.slint";
export { Button, ButtonKind } from "widgets/button.slint";
export { Stepper } from "widgets/stepper.slint";
export { Dialog } from "widgets/dialog.slint";
export { TextField } from "widgets/text-field.slint";
export { Menu, MenuEntryView } from "widgets/menu.slint";
