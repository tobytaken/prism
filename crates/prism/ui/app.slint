import { Theme, AppearanceMode } from "theme.slint";
import { AppState, MenuAnchor, ManagedProfileView, ChangeStripView, ChartId, ChartPart, ChartView, ContentKind, CurvePart, DaemonView, DetailView, DialogKind, DialogView, ExplainedStateView, FactView, Inbox, Intents, KeyPress, LimitMark, PaletteEntryView, ReadoutView, ReviewChangeView, Section, ServiceAction, SettingsSection, SidebarGpuView, StepperView, TrackView, TuningSetting, WorkspaceView } from "state.slint";
import { Menu, MenuEntryView, SegmentView } from "widgets.slint";
import { TitleBar } from "views/title-bar.slint";
import { Sidebar } from "views/sidebar.slint";
import { Workspace } from "views/workspace.slint";
import { ExplainedState } from "views/explained-state.slint";
import { StatusBar } from "views/status-bar.slint";
import { CommandPalette } from "views/command-palette.slint";
import { CloseDialog, DeleteProfileDialog, DiscardForProfileDialog, ManageProfilesDialog, ProfileCorrectionsDialog, ProfileNameDialog, ReviewDialog } from "views/dialogs.slint";
import { Settings } from "views/settings.slint";

export { Theme, AppearanceMode, AppState, MenuAnchor, ManagedProfileView, MenuEntryView, ChangeStripView, ChartId, ChartPart, ChartView, ContentKind, CurvePart, DaemonView, DetailView, DialogKind, DialogView, ExplainedStateView, FactView, Inbox, Intents, KeyPress, LimitMark, PaletteEntryView, ReadoutView, ReviewChangeView, SegmentView, Section, ServiceAction, SettingsSection, SidebarGpuView, StepperView, TrackView, TuningSetting, WorkspaceView }

// Prism's one window: frameless, with its own title bar, the sidebar, the content and the status
// bar, and the command palette or a dialog over them when one is open.
export component MainWindow inherits Window {
    title: "Prism";
    no-frame: true;
    resize-border-width: Theme.size.resize-border;
    preferred-width: Theme.size.window-width;
    preferred-height: Theme.size.window-height;
    min-width: Theme.size.window-min-width;
    min-height: Theme.size.window-min-height;
    background: Theme.color.canvas;
    default-font-family: Theme.font-ui;
    forward-focus: keys;

    // Gives the window's global shortcuts back the keyboard, after the element that had it went
    // away, such as the palette's field when the palette closes.
    public function focus-window() {
        keys.focus();
    }

    // Puts `text` on the clipboard, through a text field no one sees: Slint copies only from one.
    public function copy-to-clipboard(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
        clipboard.clear-selection();
    }

    clipboard := TextInput {
        visible: false;
        read-only: true;
        width: 0;
        height: 0;
        accessible-role: none;
    }

    // Keys no focused element used reach the global shortcuts here.
    keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            Intents.key-pressed({
                text: event.text,
                control: event.modifiers.control,
                shift: event.modifiers.shift,
                alt: event.modifiers.alt,
                meta: event.modifiers.meta,
            }, TextInputInterface.text-input-focused) ? EventResult.accept : EventResult.reject
        }

        VerticalLayout {
            TitleBar { }

            HorizontalLayout {
                vertical-stretch: 1;

                Sidebar { }

                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.color.surface;

                    if AppState.content == ContentKind.gpu: Workspace {
                        workspace: AppState.workspace;
                    }
                    if AppState.content == ContentKind.searching: ExplainedState {
                        title: "Looking for GPUs…";
                    }
                    if AppState.content == ContentKind.no-gpus: ExplainedState {
                        title: AppState.no-gpus.title;
                        reason: AppState.no-gpus.reason;
                        hint: AppState.no-gpus.hint;
                    }
                    if AppState.content == ContentKind.games: ExplainedState {
                        title: "Games";
                        reason: "This section isn't built yet.";
                    }
                    if AppState.content == ContentKind.drivers: ExplainedState {
                        title: "Drivers";
                        reason: "This section isn't built yet.";
                    }
                    if AppState.content == ContentKind.settings: Settings { }
                }
            }

            StatusBar { }
        }

        // The `⋯` profile menu, under the button that opened it. Clicks outside it close it.
        if AppState.profile-menu-open: Rectangle {
            TouchArea {
                clicked => {
                    Intents.dismiss();
                }
            }

            Menu {
                x: max(0px, MenuAnchor.right - self.width);
                y: MenuAnchor.top + Theme.space.xs;
                label: "Profile actions";
                entries: AppState.profile-menu;
                chosen(index) => {
                    Intents.run-profile-menu-entry(index);
                }
            }
        }
        if AppState.palette-open: CommandPalette { }
        if AppState.dialog.kind == DialogKind.review: ReviewDialog { }
        if AppState.dialog.kind == DialogKind.confirm-close: CloseDialog { }
        if AppState.dialog.kind == DialogKind.discard-for-profile: DiscardForProfileDialog { }
        if AppState.dialog.kind == DialogKind.profile-corrections: ProfileCorrectionsDialog { }
        if AppState.dialog.kind == DialogKind.profile-name: ProfileNameDialog { }
        if AppState.dialog.kind == DialogKind.delete-profile: DeleteProfileDialog { }
        if AppState.dialog.kind == DialogKind.manage-profiles: ManageProfilesDialog { }
    }
}
