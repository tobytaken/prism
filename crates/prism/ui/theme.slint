// Every visual value Prism uses lives here (ADR 0009). Views use only these tokens, except for
// geometry inside a chart. Only color differs between light and dark.

import { Palette } from "std-widgets.slint";

import "fonts/Inter-Regular.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";

// The user's choice of System, Light or Dark; System follows the desktop's preference.
export enum AppearanceMode { system, light, dark }

export struct Colors {
    canvas: color,
    surface: color,
    raised: color,
    hover: color,
    ink: color,
    ink-muted: color,
    rule: color,
    grid: color,
    series: color,
    accent: color,
    on-accent: color,
    danger: color,
    ok: color,
    chrome: color,
    chrome-ink: color,
    chrome-ink-muted: color,
    chrome-ink-strong: color,
    chrome-rule: color,
    chrome-hover: color,
    // C's hard pop-up shadow.
    shadow: color,
}

export struct TextStyle {
    family: string,
    size: length,
    weight: int,
    tracking: length,
}

export struct TextStyles {
    // Prism's name in the title bar.
    wordmark: TextStyle,
    // Uppercase mono labels, such as track names and sidebar rows.
    label: TextStyle,
    // A track's large current reading, and its unit.
    readout: TextStyle,
    readout-unit: TextStyle,
    // A sidebar GPU block's large temperature, and its unit.
    vital: TextStyle,
    vital-unit: TextStyle,
    // Small mono values, such as sidebar vitals and range statistics.
    value: TextStyle,
    status: TextStyle,
    title: TextStyle,
    subtitle: TextStyle,
    heading: TextStyle,
    name: TextStyle,
    body: TextStyle,
}

export struct Spacing {
    xxs: length,
    xs: length,
    s: length,
    m: length,
    l: length,
    xl: length,
    xxl: length,
}

export struct Strokes {
    hairline: length,
    series: length,
    focus: length,
    focus-offset: length,
    // The accent bar marking the selected sidebar row.
    selection: length,
}

export struct Radii {
    none: length,
    small: length,
}

export struct Sizes {
    window-width: length,
    window-height: length,
    window-min-width: length,
    window-min-height: length,
    resize-border: length,
    title-bar: length,
    window-button: length,
    window-icon: length,
    status-bar: length,
    status-dot: length,
    sidebar: length,
    gpu-block: length,
    nav-row: length,
    header: length,
    notice: length,
    track: length,
    track-head: length,
    stats: length,
    explained-state: length,
    settings-nav: length,
    settings-content: length,
    fact-label: length,
    button: length,
    text-field: length,
    kbd: length,
    palette-width: length,
    palette-top: length,
    palette-row: length,
}

export global Theme {
    // Pushed from Rust; Prism never writes Palette.color-scheme.
    in-out property <AppearanceMode> mode: AppearanceMode.system;
    out property <bool> dark: mode == AppearanceMode.system
        ? Palette.color-scheme == ColorScheme.dark
        : mode == AppearanceMode.dark;

    property <Colors> light-colors: {
        canvas: #e9e6df,
        surface: #f6f4ef,
        raised: #ffffff,
        hover: #e2ded5,
        ink: #1c1b19,
        ink-muted: #77736a,
        rule: #d2cec4,
        grid: #e3dfd6,
        series: #1c1b19,
        accent: #ff5a1f,
        on-accent: #ffffff,
        danger: #d93b2b,
        ok: #2f9e5a,
        chrome: #1c1b19,
        chrome-ink: #e9e6df,
        chrome-ink-muted: #a8a399,
        chrome-ink-strong: #ffffff,
        chrome-rule: #4a4843,
        chrome-hover: #34322e,
        shadow: #1c1b19e6,
    };
    property <Colors> dark-colors: {
        canvas: #121110,
        surface: #1a1917,
        raised: #22201d,
        hover: #292723,
        ink: #ece8df,
        ink-muted: #8e897f,
        rule: #33302b,
        grid: #262420,
        series: #ece8df,
        accent: #ff6326,
        on-accent: #ffffff,
        danger: #ff5a48,
        ok: #4cc27a,
        chrome: #0a0a09,
        chrome-ink: #ece8df,
        chrome-ink-muted: #8e897f,
        chrome-ink-strong: #ffffff,
        chrome-rule: #3a3732,
        chrome-hover: #23211e,
        shadow: #000000b3,
    };
    out property <Colors> color: dark ? dark-colors : light-colors;

    out property <string> font-ui: "Inter";
    out property <string> font-mono: "JetBrains Mono";
    out property <TextStyles> text: {
        wordmark: { family: font-mono, size: 11px, weight: 700, tracking: 2.6px },
        label: { family: font-mono, size: 10px, weight: 400, tracking: 1.4px },
        readout: { family: font-mono, size: 22px, weight: 400, tracking: 0px },
        readout-unit: { family: font-mono, size: 12px, weight: 400, tracking: 0px },
        vital: { family: font-mono, size: 30px, weight: 400, tracking: -0.6px },
        vital-unit: { family: font-mono, size: 14px, weight: 400, tracking: 0px },
        value: { family: font-mono, size: 10px, weight: 400, tracking: 0px },
        status: { family: font-mono, size: 10px, weight: 400, tracking: 0.6px },
        title: { family: font-ui, size: 18px, weight: 600, tracking: -0.18px },
        subtitle: { family: font-mono, size: 10px, weight: 400, tracking: 0px },
        heading: { family: font-ui, size: 14px, weight: 600, tracking: 0px },
        name: { family: font-ui, size: 12px, weight: 600, tracking: 0px },
        body: { family: font-ui, size: 12px, weight: 400, tracking: 0px },
    };

    out property <Spacing> space: {
        xxs: 2px,
        xs: 4px,
        s: 6px,
        m: 8px,
        l: 10px,
        xl: 12px,
        xxl: 14px,
    };
    out property <Strokes> stroke: {
        hairline: 1px,
        series: 1.4px,
        focus: 1px,
        focus-offset: 2px,
        selection: 3px,
    };
    out property <Radii> radius: { none: 0px, small: 3px };
    // C's hard pop-up shadow, drawn as an offset Rectangle so every renderer shows it (see
    // PopupSurface).
    out property <length> shadow-offset: 6px;
    out property <Sizes> size: {
        window-width: 1280px,
        window-height: 800px,
        window-min-width: 960px,
        window-min-height: 600px,
        resize-border: 6px,
        title-bar: 30px,
        window-button: 30px,
        window-icon: 10px,
        status-bar: 24px,
        status-dot: 6px,
        sidebar: 196px,
        gpu-block: 106px,
        nav-row: 34px,
        header: 58px,
        notice: 30px,
        track: 104px,
        track-head: 224px,
        stats: 96px,
        explained-state: 420px,
        settings-nav: 180px,
        settings-content: 560px,
        fact-label: 120px,
        button: 28px,
        text-field: 34px,
        kbd: 16px,
        palette-width: 520px,
        palette-top: 72px,
        palette-row: 30px,
    };
}
