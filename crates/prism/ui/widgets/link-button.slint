import { Theme, TextStyle } from "../theme.slint";
import { PressArea } from "press-area.slint";
import { StyledText } from "styled-text.slint";

// A button that reads as a word in a line of text, such as the "Set up" that ends an explanation.
export component LinkButton inherits Rectangle {
    in property <string> text;
    // What a screen reader calls it, when `text` alone doesn't say, such as "Copy" next to one of
    // several commands.
    in property <string> label: text;
    // Its text's style, such as the values' style next to a value.
    in property <TextStyle> style: Theme.text.name;
    callback activated();

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.activated();
    }
    forward-focus: press;
    width: caption.preferred-width + 2 * Theme.space.xs;
    background: press.has-hover ? Theme.color.hover : transparent;

    press := PressArea {
        activated => {
            root.activated();
        }
    }

    caption := StyledText {
        text: root.text;
        style: root.style;
        accessible-role: none;
    }
}
