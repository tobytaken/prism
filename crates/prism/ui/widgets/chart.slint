import { Theme } from "../theme.slint";

// A chart's background grid. Chart parts carry no accessible role; the track's readout does.
export component Grid inherits Rectangle {
    in property <int> rows: 3;
    in property <int> columns: 6;
    accessible-role: none;

    for row in rows: Rectangle {
        x: 0;
        y: round(parent.height * (row + 1) / (rows + 1) / 1px) * 1px;
        width: parent.width;
        height: Theme.stroke.hairline;
        background: Theme.color.grid;
    }
    for column in columns - 1: Rectangle {
        x: round(parent.width * (column + 1) / columns / 1px) * 1px;
        y: 0;
        width: Theme.stroke.hairline;
        height: parent.height;
        background: Theme.color.grid;
    }
}

// A line through a series' readings. Rust supplies the path commands, in the chart's own pixels.
export component Series inherits Path {
    width: 100%;
    height: 100%;
    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    stroke: Theme.color.series;
    stroke-width: Theme.stroke.series;
    stroke-line-join: round;
    accessible-role: none;
}

// The area under a series, filled down to the chart's bottom. Rust supplies the path commands, in
// the chart's own pixels.
export component Area inherits Path {
    width: 100%;
    height: 100%;
    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    fill: Theme.color.area;
    // Slint fits a stroked path inside its box; an invisible stroke as wide as the series' keeps the
    // area under its line.
    stroke: transparent;
    stroke-width: Theme.stroke.series;
    accessible-role: none;
}

// A fan curve across its editor, in the series' ink or in another, such as the accent while it's
// pending. Rust supplies the path commands, in the editor's own pixels.
export component CurveLine inherits Path {
    in property <color> ink: Theme.color.series;
    width: 100%;
    height: 100%;
    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    stroke: ink;
    stroke-width: Theme.stroke.limit;
    stroke-line-join: round;
    accessible-role: none;
}

// A limit across a chart, solid or built from dashes. Rust supplies the path commands, in the
// chart's own pixels.
export component LimitLine inherits Path {
    in property <color> ink: Theme.color.accent;
    width: 100%;
    height: 100%;
    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    stroke: ink;
    stroke-width: Theme.stroke.limit;
    accessible-role: none;
}
