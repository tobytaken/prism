import { Theme } from "../theme.slint";
import { PressArea } from "press-area.slint";
import { StyledText } from "styled-text.slint";

// An on/off switch with its label before it, such as "Automatic switching". The knob sits right
// and the track is filled in the accent while it's on. Read-only, it shows its state with no
// affordances, still takes focus, and says why in its description.
export component Switch inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <bool> read-only;
    // Why it's read-only, when it is.
    in property <string> reason;
    callback toggled();

    accessible-role: switch;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-read-only: read-only;
    accessible-description: read-only ? reason : "";
    accessible-action-default => {
        if !root.read-only {
            root.toggled();
        }
    }
    forward-focus: press;
    height: Theme.size.button;
    width: row.preferred-width;

    // Read-only, it still takes focus, so the keyboard reaches it and why it's read-only.
    press := PressArea {
        activated => {
            if !root.read-only {
                root.toggled();
            }
        }
    }

    row := HorizontalLayout {
        spacing: Theme.space.l;

        StyledText {
            text: root.label;
            style: Theme.text.name;
            accessible-role: none;
        }

        Rectangle {
            width: Theme.size.switch-width;
            height: Theme.size.switch-height;
            y: (parent.height - self.height) / 2;
            background: root.checked && !root.read-only ? Theme.color.accent : transparent;
            border-width: Theme.stroke.hairline;
            border-color: root.read-only ? Theme.color.rule
                : root.checked ? Theme.color.accent : Theme.color.ink-muted;

            Rectangle {
                width: parent.height - 4 * Theme.stroke.hairline;
                height: self.width;
                x: root.checked ? parent.width - self.width - 2 * Theme.stroke.hairline
                    : 2 * Theme.stroke.hairline;
                y: 2 * Theme.stroke.hairline;
                background: root.read-only ? Theme.color.rule
                    : root.checked ? Theme.color.on-accent
                    : press.has-hover ? Theme.color.ink : Theme.color.ink-muted;
            }
        }

        StyledText {
            text: root.checked ? "On" : "Off";
            style: Theme.text.value;
            color: root.read-only ? Theme.color.ink-muted : Theme.color.ink;
            accessible-role: none;
        }
    }
}
