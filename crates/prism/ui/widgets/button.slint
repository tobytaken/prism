import { Theme } from "../theme.slint";
import { PressArea } from "press-area.slint";
import { StyledText } from "styled-text.slint";

// A bordered button for an action of its own, such as "Enable prismd". While it can't be pressed
// it's dimmed and does nothing.
export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback activated();

    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => {
        if root.enabled {
            root.activated();
        }
    }
    forward-focus: press;
    height: Theme.size.button;
    width: label.preferred-width + 2 * Theme.space.xl;
    background: enabled && press.has-hover ? Theme.color.hover : Theme.color.raised;
    border-width: Theme.stroke.hairline;
    border-color: enabled ? Theme.color.ink : Theme.color.rule;

    press := PressArea {
        enabled: root.enabled;
        activated => {
            root.activated();
        }
    }

    label := StyledText {
        text: root.text;
        style: Theme.text.name;
        color: root.enabled ? Theme.color.ink : Theme.color.ink-muted;
        horizontal-alignment: center;
        accessible-role: none;
    }
}
