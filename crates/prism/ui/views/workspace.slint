import { Theme } from "../theme.slint";
import { Button, ButtonKind, Divider, LinkButton, Segmented, StyledText } from "../widgets.slint";
import { AppState, ChangeStripView, Intents, MenuAnchor, SettingsSection, WorkspaceView } from "../state.slint";
import { HardwareDetails } from "hardware-details.slint";
import { Track } from "track.slint";

// Why every control is read-only, and where to fix it: "Tuning needs prismd · reason · Set up".
component TuningNeedsPrismd inherits Rectangle {
    in property <string> reason;

    height: Theme.size.notice;

    HorizontalLayout {
        padding-left: Theme.space.xxl;
        padding-right: Theme.space.xxl;
        spacing: Theme.space.s;
        alignment: start;

        Rectangle {
            accessible-role: text;
            accessible-label: "Tuning needs prismd";
            accessible-value: root.reason;
            width: line.preferred-width;

            line := HorizontalLayout {
                spacing: Theme.space.s;

                StyledText {
                    text: "Tuning needs prismd";
                    style: Theme.text.body;
                    accessible-role: none;
                }

                for part in ["·", root.reason, "·"]: StyledText {
                    text: part;
                    style: Theme.text.body;
                    color: Theme.color.ink-muted;
                    accessible-role: none;
                }
            }
        }

        LinkButton {
            text: "Set up";
            activated => {
                Intents.go-to-settings(SettingsSection.daemon);
            }
        }
    }

    Divider {
        y: parent.height - self.height;
    }
}

// The fixed strip under the header: "No unapplied changes", or, marked in the accent, how many
// there are with Discard and Apply. It's always there and never changes height, so nothing moves
// under a drag.
component ChangeStrip inherits Rectangle {
    in property <ChangeStripView> changes;

    accessible-role: groupbox;
    accessible-label: "Unapplied changes";
    accessible-description: changes.review != "" ? changes.review : changes.outcome;
    height: Theme.size.notice;

    if root.changes.pending: Rectangle {
        x: 0;
        width: Theme.stroke.selection;
        background: Theme.color.accent;
    }

    HorizontalLayout {
        padding-left: Theme.space.xxl;
        padding-right: Theme.space.xxl;
        spacing: Theme.space.s;

        StyledText {
            text: root.changes.summary;
            style: Theme.text.body;
            color: root.changes.pending ? Theme.color.accent : Theme.color.ink-muted;
            vertical-alignment: center;
        }

        // What needs a review before Apply, or else what the last Apply applied and what it left
        // unapplied, and why.
        StyledText {
            horizontal-stretch: 1;
            text: root.changes.review != "" ? root.changes.review : root.changes.outcome;
            style: Theme.text.body;
            color: Theme.color.ink-muted;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }

        if root.changes.pending: VerticalLayout {
            alignment: center;

            Button {
                text: "Discard";
                height: Theme.size.segment;
                kind: ButtonKind.quiet;
                enabled: root.changes.can-discard;
                description: root.changes.can-discard ? "Ctrl+Shift+Backspace" : root.changes.discard-reason;
                activated => {
                    Intents.discard-changes();
                }
            }
        }

        if root.changes.pending: VerticalLayout {
            alignment: center;

            // While a change under them needs a review, Apply opens it.
            Button {
                text: root.changes.review != "" ? "Review" : "Apply";
                height: Theme.size.segment;
                kind: ButtonKind.accent;
                enabled: root.changes.can-apply;
                description: root.changes.can-apply ? "Ctrl+Enter" : root.changes.apply-reason;
                activated => {
                    Intents.apply-changes();
                }
            }
        }
    }

    Divider {
        y: parent.height - self.height;
    }
}

// The latest request to scroll the Fans track into view that a workspace answered. It outlives
// the workspace, which a request made elsewhere, such as from Games, shows anew.
global FansReveal {
    in-out property <int> answered;
}

// The selected GPU's workspace: its header with the range picker, then one full-width track per
// metric and the hardware details. When they don't fit, they scroll under the header. Narrower
// than `narrow-workspace`, the tracks are narrow, and shorter than `short-workspace`, short.
export component Workspace inherits Rectangle {
    in property <WorkspaceView> workspace;

    property <bool> short: root.height < Theme.size.short-workspace;
    property <int> reveal-fans: root.workspace.reveal-fans;

    // Scrolls the tracks so the Fans track, the last above the hardware details, ends in view,
    // once for each request.
    function show-fans() {
        if root.reveal-fans == FansReveal.answered {
            return;
        }
        FansReveal.answered = root.reveal-fans;
        reveal.running = true;
    }

    // Scrolls once the tracks are laid out, which they aren't yet in a workspace just shown.
    reveal := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            tracks.content-y = min(0px, tracks.height - (tracks.content-height - hardware.height));
        }
    }

    init => {
        root.show-fans();
    }
    changed reveal-fans => {
        root.show-fans();
    }

    VerticalLayout {
        Rectangle {
            height: root.short ? Theme.size.header-short : Theme.size.header;

            HorizontalLayout {
                padding-left: Theme.space.xxl;
                padding-right: Theme.space.xxl;
                spacing: Theme.space.xxl;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;

                    StyledText {
                        text: root.workspace.title;
                        style: Theme.text.title;
                        overflow: elide;
                    }

                    StyledText {
                        text: root.workspace.subtitle;
                        style: Theme.text.subtitle;
                        color: Theme.color.ink-muted;
                    }
                }

                // The GPU's profiles: one click applies one.
                if root.workspace.has-profiles: VerticalLayout {
                    alignment: center;

                    Segmented {
                        label: "Profiles";
                        segments: AppState.profiles;
                        read-only: root.workspace.profiles-read-only;
                        reason: root.workspace.profiles-reason;
                        value: root.workspace.current-profile;
                        value-text: root.workspace.current-profile;
                        chosen(index) => {
                            Intents.apply-profile(index);
                        }
                    }
                }

                // Applied values or explicit defaults that differ from the current profile.
                if root.workspace.profiles-not-saved: StyledText {
                    text: "not saved to profile";
                    style: Theme.text.value;
                    color: Theme.color.ink-muted;
                    vertical-alignment: center;
                    accessible-role: text;
                    accessible-label: "not saved to profile";
                }

                // The GPU's profile actions, such as saving and renaming.
                VerticalLayout {
                    alignment: center;

                    more := Button {
                        text: "⋯";
                        label: "Profile actions";
                        style: Theme.text.readout-unit;
                        kind: ButtonKind.quiet;
                        height: Theme.size.segment;
                        activated => {
                            MenuAnchor.right = self.absolute-position.x + self.width;
                            MenuAnchor.top = self.absolute-position.y + self.height;
                            Intents.toggle-profile-menu();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    Segmented {
                        label: "Range";
                        segments: AppState.ranges;
                        chosen(index) => {
                            Intents.show-range(index);
                        }
                    }
                }
            }

            Divider {
                y: parent.height - self.height;
            }
        }

        ChangeStrip {
            changes: root.workspace.changes;
        }

        if root.workspace.no-tuning-access != "": TuningNeedsPrismd {
            reason: root.workspace.no-tuning-access;
        }

        tracks := Flickable {
            vertical-stretch: 1;
            content-height: max(self.height, body.min-height);

            body := VerticalLayout {
                height: tracks.content-height;

                for track in AppState.tracks: Track {
                    track: track;
                    narrow: root.width < Theme.size.narrow-workspace;
                    short: root.short;
                }

                hardware := HardwareDetails {
                    open: root.workspace.hardware-open;
                }
            }
        }
    }
}
