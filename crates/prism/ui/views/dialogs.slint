import { Theme } from "../theme.slint";
import { Button, ButtonKind, Dialog, StyledText, TextField } from "../widgets.slint";
import { AppState, Intents, ManagedProfileView, ProgramView, ReviewChangeView, SteamAppView } from "../state.slint";

// A current tuning value that changed under the draft: the setting, from what to what, and what
// the draft stages for it.
component Change inherits Rectangle {
    in property <ReviewChangeView> change;

    accessible-role: text;
    accessible-label: change.name;
    accessible-value: change.change;
    accessible-description: change.yours;
    height: row.preferred-height;

    row := HorizontalLayout {
        spacing: Theme.space.m;

        StyledText {
            width: Theme.size.fact-label;
            text: root.change.name;
            style: Theme.text.body;
            color: Theme.color.ink-muted;
            accessible-role: none;
        }

        StyledText {
            horizontal-stretch: 1;
            text: root.change.change;
            style: Theme.text.value;
            accessible-role: none;
        }

        if root.change.yours != "": StyledText {
            text: root.change.yours;
            style: Theme.text.value;
            color: Theme.color.accent;
            accessible-role: none;
        }
    }
}

// The actions along a dialog's bottom edge, at its end.
component Actions inherits HorizontalLayout {
    alignment: end;
    spacing: Theme.space.s;
    padding-top: Theme.space.s;
}

// The GPU's tuning state changed since the draft was made, so prismd refused its Apply or the
// draft would replace a cooling change the user hasn't seen: what changed, then Discard, or Apply
// over the new state. Escape keeps editing.
export component ReviewDialog inherits Dialog {
    title: AppState.dialog.title;
    message: AppState.dialog.message;

    VerticalLayout {
        spacing: Theme.space.xs;

        for change in AppState.review-changes: Change {
            change: change;
        }
    }

    Actions {
        Button {
            text: "Discard";
            kind: ButtonKind.quiet;
            enabled: AppState.dialog.can-discard;
            description: AppState.dialog.can-discard ? "Ctrl+Shift+Backspace" : AppState.dialog.discard-reason;
            activated => {
                Intents.discard-changes();
            }
        }

        apply := Button {
            text: AppState.dialog.apply-text;
            kind: ButtonKind.accent;
            enabled: AppState.dialog.can-apply;
            description: AppState.dialog.can-apply ? "Ctrl+Enter" : AppState.dialog.apply-reason;
            init => {
                self.focus();
            }
            activated => {
                Intents.apply-changes();
            }
        }
    }
}

// Closing with unapplied tuning changes: "N unapplied changes", then Discard and close, or Keep
// editing, which Escape also does. There's no Apply here.
export component CloseDialog inherits Dialog {
    title: AppState.dialog.title;
    message: AppState.dialog.message;

    Actions {
        Button {
            text: "Discard and close";
            kind: ButtonKind.quiet;
            activated => {
                Intents.discard-and-close();
            }
        }

        Button {
            text: "Keep editing";
            kind: ButtonKind.accent;
            init => {
                self.focus();
            }
            activated => {
                Intents.dismiss();
            }
        }
    }
}

// Choosing a profile over the GPU's unapplied tuning changes: "Discard N unapplied changes and
// apply Quiet?", then Discard and apply, or Keep editing, which Escape also does.
export component DiscardForProfileDialog inherits Dialog {
    title: AppState.dialog.title;
    message: AppState.dialog.message;

    Actions {
        Button {
            text: "Discard and apply";
            kind: ButtonKind.quiet;
            activated => {
                Intents.confirm-profile();
            }
        }

        Button {
            text: "Keep editing";
            kind: ButtonKind.accent;
            init => {
                self.focus();
            }
            activated => {
                Intents.dismiss();
            }
        }
    }
}

// A profile's values outside what the GPU allows now: each from its saved value to the one it
// would become, then Cancel, which Escape also does and which changes nothing, or Adjust profile
// and apply.
export component ProfileCorrectionsDialog inherits Dialog {
    title: AppState.dialog.title;
    message: AppState.dialog.message;

    VerticalLayout {
        spacing: Theme.space.xs;

        for change in AppState.review-changes: Change {
            change: change;
        }
    }

    Actions {
        Button {
            text: "Cancel";
            kind: ButtonKind.quiet;
            activated => {
                Intents.dismiss();
            }
        }

        Button {
            text: "Adjust profile and apply";
            kind: ButtonKind.accent;
            init => {
                self.focus();
            }
            activated => {
                Intents.confirm-profile();
            }
        }
    }
}

// What's wrong, in the danger color, such as a name another profile has or why prismd refused it.
component Problem inherits StyledText {
    style: Theme.text.body;
    color: Theme.color.danger;
    wrap: word-wrap;
    accessible-role: text;
    accessible-label: "Problem";
    accessible-value: self.text;
}

// The name of a new profile, or a profile's new name: Return or the confirmation sends it, and
// Cancel or Escape changes nothing. A name another of the GPU's profiles has shows as it's typed.
export component ProfileNameDialog inherits Dialog {
    title: AppState.dialog.title;
    message: AppState.dialog.message;

    field := TextField {
        label: "Profile name";
        placeholder: "Profile name";
        text: AppState.dialog.name;
        init => {
            self.focus();
            self.select-all();
        }
        edited(name) => {
            Intents.edit-profile-name(name);
        }
        accepted => {
            Intents.confirm-profile();
        }
    }

    if AppState.dialog.error != "": Problem {
        text: AppState.dialog.error;
    }

    Actions {
        Button {
            text: "Cancel";
            kind: ButtonKind.quiet;
            activated => {
                Intents.dismiss();
            }
        }

        Button {
            text: AppState.dialog.confirm-text;
            kind: ButtonKind.accent;
            enabled: AppState.dialog.can-confirm;
            description: AppState.dialog.confirm-reason;
            activated => {
                Intents.confirm-profile();
            }
        }
    }
}

// Deleting a profile, which can't be undone: Delete, or Cancel, which Escape also does and which
// has the keyboard.
export component DeleteProfileDialog inherits Dialog {
    title: AppState.dialog.title;
    message: AppState.dialog.message;

    if AppState.dialog.error != "": Problem {
        text: AppState.dialog.error;
    }

    Actions {
        Button {
            text: "Delete";
            kind: ButtonKind.plain;
            enabled: AppState.dialog.can-confirm;
            description: AppState.dialog.confirm-reason;
            activated => {
                Intents.confirm-profile();
            }
        }

        Button {
            text: "Cancel";
            kind: ButtonKind.accent;
            init => {
                self.focus();
            }
            activated => {
                Intents.dismiss();
            }
        }
    }
}

// One of the GPU's profiles in Manage profiles: its name and marks, then Rename and Delete.
component ManagedProfile inherits Rectangle {
    in property <ManagedProfileView> profile;
    in property <bool> can-change;
    in property <string> reason;
    callback rename();
    callback delete();

    height: row.preferred-height;

    row := HorizontalLayout {
        spacing: Theme.space.m;

        Rectangle {
            horizontal-stretch: 1;
            accessible-role: text;
            accessible-label: root.profile.name;
            accessible-value: root.profile.marks;

            HorizontalLayout {
                spacing: Theme.space.m;

                StyledText {
                    text: root.profile.name;
                    style: Theme.text.body;
                    overflow: elide;
                    accessible-role: none;
                }

                StyledText {
                    horizontal-stretch: 1;
                    text: root.profile.marks;
                    style: Theme.text.value;
                    color: Theme.color.ink-muted;
                    overflow: elide;
                    accessible-role: none;
                }
            }
        }

        Button {
            text: "Rename";
            label: "Rename \{root.profile.name}";
            kind: ButtonKind.quiet;
            enabled: root.can-change;
            description: root.reason;
            activated => {
                root.rename();
            }
        }

        Button {
            text: "Delete";
            label: "Delete \{root.profile.name}";
            kind: ButtonKind.quiet;
            enabled: root.can-change;
            description: root.reason;
            activated => {
                root.delete();
            }
        }
    }
}

// The GPU's profiles, each with Rename and Delete, which ask in a dialog of their own and come
// back here. Done or Escape closes it.
export component ManageProfilesDialog inherits Dialog {
    title: AppState.dialog.title;
    message: AppState.dialog.message;

    VerticalLayout {
        spacing: Theme.space.xs;

        for profile[index] in AppState.managed-profiles: ManagedProfile {
            profile: profile;
            can-change: AppState.dialog.confirm-reason == "";
            reason: AppState.dialog.confirm-reason;
            rename => {
                Intents.rename-profile(index);
            }
            delete => {
                Intents.delete-profile(index);
            }
        }

        if AppState.managed-profiles.length == 0: StyledText {
            text: "This GPU has no profiles.";
            style: Theme.text.body;
            color: Theme.color.ink-muted;
        }
    }

    Actions {
        Button {
            text: "Done";
            kind: ButtonKind.accent;
            init => {
                self.focus();
            }
            activated => {
                Intents.dismiss();
            }
        }
    }
}

// One of the caller's Steam apps in Add Steam game: its name, then Add, dimmed with why when it
// can't be added, such as when it's added already.
component SteamApp inherits Rectangle {
    in property <SteamAppView> app;
    callback add();

    height: row.preferred-height;

    row := HorizontalLayout {
        spacing: Theme.space.m;

        StyledText {
            horizontal-stretch: 1;
            text: root.app.name;
            style: Theme.text.body;
            color: root.app.available ? Theme.color.ink : Theme.color.ink-muted;
            overflow: elide;
            accessible-role: none;
        }

        if !root.app.available: StyledText {
            text: root.app.reason;
            style: Theme.text.value;
            color: Theme.color.ink-muted;
            accessible-role: none;
        }

        Button {
            text: "Add";
            label: "Add \{root.app.name}";
            kind: ButtonKind.quiet;
            enabled: root.app.available;
            description: root.app.reason;
            activated => {
                root.add();
            }
        }
    }
}

// The caller's installed Steam apps, searched as typed, each with Add; it closes once prismd adds
// the one chosen. What the list waits for, or why it's empty, shows in its place, and why prismd
// refused an app under it. Close or Escape closes it.
export component AddSteamGameDialog inherits Dialog {
    title: AppState.dialog.title;
    message: AppState.dialog.message;

    TextField {
        label: "Search Steam games";
        placeholder: "Search Steam games";
        text: AppState.dialog.name;
        init => {
            self.focus();
        }
        edited(query) => {
            Intents.filter-steam-apps(query);
        }
    }

    if AppState.dialog.status != "": StyledText {
        text: AppState.dialog.status;
        style: Theme.text.body;
        color: Theme.color.ink-muted;
        wrap: word-wrap;
    }

    apps := Flickable {
        height: min(list.preferred-height, Theme.size.dialog-list);
        content-height: list.preferred-height;

        list := VerticalLayout {
            spacing: Theme.space.xs;

            for app[index] in AppState.steam-apps: SteamApp {
                app: app;
                add => {
                    Intents.add-steam-app(index);
                }
            }
        }
    }

    if AppState.dialog.error != "": Problem {
        text: AppState.dialog.error;
    }

    Actions {
        Button {
            text: "Close";
            kind: ButtonKind.quiet;
            activated => {
                Intents.dismiss();
            }
        }
    }
}

// One of the caller's running programs in Add program: its name over its host location and why
// prismd may not recognize it there, then Add, dimmed with why when it can't be added, such as
// when it's added already or its host location is unknown.
component RunningProgram inherits Rectangle {
    in property <ProgramView> program;
    callback add();

    height: row.preferred-height;

    row := HorizontalLayout {
        spacing: Theme.space.m;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;

            StyledText {
                text: root.program.name;
                style: Theme.text.body;
                color: root.program.available ? Theme.color.ink : Theme.color.ink-muted;
                overflow: elide;
                accessible-role: none;
            }

            StyledText {
                text: root.program.detail;
                style: Theme.text.value;
                color: Theme.color.ink-muted;
                overflow: elide;
                accessible-role: none;
            }

            if root.program.warning != "": StyledText {
                text: root.program.warning;
                style: Theme.text.value;
                color: Theme.color.ink-muted;
                wrap: word-wrap;
                accessible-role: none;
            }
        }

        if !root.program.available: StyledText {
            text: root.program.reason;
            style: Theme.text.value;
            color: Theme.color.ink-muted;
            vertical-alignment: center;
            accessible-role: none;
        }

        Button {
            text: "Add";
            label: "Add \{root.program.name}";
            kind: ButtonKind.quiet;
            enabled: root.program.available;
            // Where it is, and why prismd may not recognize it there, or why it can't be added.
            description: !root.program.available ? root.program.reason : root.program.warning == "" ? root.program.detail : "\{root.program.detail} · \{root.program.warning}";
            activated => {
                root.add();
            }
        }
    }
}

// The caller's running programs, searched as typed, each with Add, and Browse… for a program file
// in the desktop's file chooser; it closes once prismd adds the one chosen. What the list waits
// for, or why it's empty, shows in its place, and why the last one chosen couldn't be added under
// it. Close or Escape closes it.
export component AddProgramDialog inherits Dialog {
    title: AppState.dialog.title;
    message: AppState.dialog.message;

    TextField {
        label: "Search running programs";
        placeholder: "Search running programs";
        text: AppState.dialog.name;
        init => {
            self.focus();
        }
        edited(query) => {
            Intents.filter-programs(query);
        }
    }

    if AppState.dialog.status != "": StyledText {
        text: AppState.dialog.status;
        style: Theme.text.body;
        color: Theme.color.ink-muted;
        wrap: word-wrap;
    }

    programs := Flickable {
        height: min(list.preferred-height, Theme.size.dialog-list);
        content-height: list.preferred-height;

        list := VerticalLayout {
            spacing: Theme.space.s;

            for program[index] in AppState.programs: RunningProgram {
                program: program;
                add => {
                    Intents.add-running-program(index);
                }
            }
        }
    }

    if AppState.dialog.error != "": Problem {
        text: AppState.dialog.error;
    }

    Actions {
        Button {
            text: "Browse…";
            enabled: AppState.dialog.can-confirm;
            activated => {
                Intents.browse-for-program();
            }
        }

        Button {
            text: "Close";
            kind: ButtonKind.quiet;
            activated => {
                Intents.dismiss();
            }
        }
    }
}
