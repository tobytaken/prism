import { Theme } from "../theme.slint";
import { Area, Button, CurveLine, DisclosureMarker, Divider, Grid, LimitLine, LinkButton, PressArea, Segmented, Series, Stepper, StyledText, VerticalDivider } from "../widgets.slint";
import { AppState, ChartPart, ChartView, CoolingProblemView, CurvePart, CurvePointView, DetailView, FanCurveView, FanModeView, Intents, LimitMark, ReadoutView, StepperView, TrackView, TuningSetting } from "../state.slint";

component Statistic inherits Rectangle {
    in property <string> name;
    in property <string> label;
    in property <ReadoutView> readout;

    accessible-role: text;
    accessible-label: label;
    accessible-value: readout.spoken;
    height: row.preferred-height;

    row := HorizontalLayout {
        alignment: start;
        spacing: Theme.space.s;

        StyledText {
            text: root.name;
            style: Theme.text.value;
            color: Theme.color.ink-muted;
            accessible-role: none;
        }

        StyledText {
            text: root.readout.text;
            style: Theme.text.value;
            accessible-role: none;
        }
    }
}

// How a limit's line is drawn, next to its value: solid, or dashed. Muted while the limit is
// unknown, since no line is drawn.
component LimitKey inherits Rectangle {
    in property <LimitMark> mark;
    in property <bool> known;
    property <color> ink: known ? Theme.color.accent : Theme.color.ink-muted;

    width: Theme.size.swatch;

    if root.mark == LimitMark.solid: Rectangle {
        y: (parent.height - self.height) / 2;
        height: Theme.stroke.limit;
        background: root.ink;
    }
    if root.mark == LimitMark.dashed: HorizontalLayout {
        y: (parent.height - self.height) / 2;
        height: Theme.stroke.limit;
        spacing: Theme.stroke.dash-gap;
        alignment: start;

        for dash in 2: Rectangle {
            width: Theme.stroke.dash;
            background: root.ink;
        }
    }
}

// A current value under the readout, such as the power limit; a limit's value is in the accent,
// next to how its line is drawn.
component Detail inherits Rectangle {
    in property <DetailView> detail;

    accessible-role: text;
    accessible-label: detail.name;
    accessible-value: detail.readout.spoken;
    accessible-description: detail.unknown-reason;
    height: row.preferred-height;

    row := HorizontalLayout {
        alignment: start;
        spacing: Theme.space.s;

        if root.detail.mark != LimitMark.none: LimitKey {
            mark: root.detail.mark;
            known: root.detail.readout.known;
        }

        StyledText {
            text: root.detail.label;
            style: Theme.text.value;
            color: Theme.color.ink-muted;
            accessible-role: none;
        }

        StyledText {
            text: root.detail.readout.text;
            style: Theme.text.value;
            color: root.detail.mark != LimitMark.none && root.detail.readout.known ? Theme.color.accent : Theme.color.ink;
            accessible-role: none;
        }
    }
}

// A tuning value's stepper, staging what it's changed to.
component TuningStepper inherits Stepper {
    in property <StepperView> stepper;

    label: stepper.label;
    value: stepper.value;
    value-text: stepper.value-text;
    minimum: stepper.minimum;
    maximum: stepper.maximum;
    step: stepper.step;
    text: stepper.text;
    pending: stepper.pending;
    read-only: stepper.read-only;
    reason: stepper.reason;
    failure: stepper.failure;
    changed(value) => {
        Intents.stage(stepper.setting, value);
    }
}

// A tuning value tuned in place, such as the power limit or a clock offset: how its line is drawn
// if it's a limit, its label and Use default, then its stepper with any pending value on a line of
// its own. Read-only, it's one line like any other detail, with its value after its label, and so
// is the fixed fan speed, which has no default to use.
component TuningDetail inherits VerticalLayout {
    in property <DetailView> detail;
    // In a short track, its lines close up.
    in property <bool> short;
    property <StepperView> stepper: detail.stepper;
    property <bool> one-line: stepper.read-only || stepper.setting == TuningSetting.fan-speed;

    spacing: root.short ? 0 : Theme.space.xxs;

    HorizontalLayout {
        spacing: Theme.space.s;

        if root.detail.mark != LimitMark.none: LimitKey {
            mark: root.detail.mark;
            known: root.detail.readout.known;
        }

        StyledText {
            text: root.detail.label;
            style: Theme.text.value;
            color: Theme.color.ink-muted;
            vertical-alignment: center;
            accessible-role: none;
        }

        if root.one-line: TuningStepper {
            stepper: root.stepper;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        if root.stepper.can-use-default: LinkButton {
            text: "default";
            label: root.stepper.default-label;
            style: Theme.text.value;
            activated => {
                Intents.use-default(root.stepper.setting);
            }
        }
    }

    if !root.one-line: TuningStepper {
        stepper: root.stepper;
    }
}

// With more than one fan, whether the cooling controls set every fan together or one fan on its
// own, with a change between one shared configuration and per-fan settings pending next to it.
component FanPicker inherits Segmented {
    in property <FanModeView> fan-mode;

    label: "Fan arrangement";
    segments: root.fan-mode.fans;
    pending: root.fan-mode.arrangement-pending;
    chosen(index) => {
        Intents.pick-fans(index);
    }
}

// The fan control mode of the fans the fan picker picked, what the user should know about the
// GPU's cooling under it, and Recall remembered curve while it can run.
component FanMode inherits VerticalLayout {
    in property <FanModeView> fan-mode;
    // In a short track, its lines close up.
    in property <bool> short;

    spacing: root.short ? 0 : Theme.space.xxs;

    // Read-only, it's one line like any other detail, with the mode after its label.
    HorizontalLayout {
        alignment: start;
        spacing: Theme.space.s;

        if root.fan-mode.read-only: StyledText {
            text: "mode";
            style: Theme.text.value;
            color: Theme.color.ink-muted;
            accessible-role: none;
        }

        Segmented {
            label: "Fan control mode";
            segments: root.fan-mode.modes;
            pending: root.fan-mode.pending;
            failure: root.fan-mode.failure;
            read-only: root.fan-mode.read-only;
            reason: root.fan-mode.reason;
            value: root.fan-mode.mode;
            value-text: root.fan-mode.mode-text;
            compact: root.short;
            chosen(index) => {
                Intents.stage-fan-mode(index);
            }
        }
    }

    if root.fan-mode.note != "": StyledText {
        text: root.fan-mode.note;
        style: Theme.text.value;
        color: Theme.color.ink-muted;
        wrap: word-wrap;
        accessible-role: text;
        accessible-label: "Cooling";
        accessible-value: root.fan-mode.note;
    }

    if root.fan-mode.can-recall: HorizontalLayout {
        alignment: start;

        LinkButton {
            text: "Recall remembered curve";
            label: "Recall remembered fan curve";
            style: Theme.text.value;
            activated => {
                Intents.recall-remembered-curve();
            }
        }
    }
}

// Why Prism stopped following the GPU's fan curve, across the bottom of the Fans track: a cooling
// fault, after which its fans fell back to automatic cooling, or another tool's change to fan
// control, with Retry or Resume, and why prismd didn't apply the latest one. It's marked in the
// danger color, as Activity marks problems.
component CoolingProblem inherits Rectangle {
    in property <CoolingProblemView> problem;

    accessible-role: groupbox;
    accessible-label: root.problem.title;
    accessible-description: root.problem.detail;

    Divider {
        y: 0;
    }

    Rectangle {
        x: 0;
        width: Theme.stroke.selection;
        background: Theme.color.danger;
    }

    VerticalLayout {
        padding-top: Theme.space.s;
        padding-bottom: Theme.space.s;
        padding-left: Theme.space.xxl;
        padding-right: Theme.space.xxl;
        spacing: Theme.space.xxs;

        HorizontalLayout {
            spacing: Theme.space.m;

            StyledText {
                text: root.problem.title;
                style: Theme.text.name;
                color: Theme.color.danger;
                vertical-alignment: center;
                horizontal-stretch: 1;
                accessible-role: none;
            }

            Button {
                text: root.problem.action;
                label: root.problem.action + " · " + root.problem.title;
                enabled: root.problem.available;
                description: root.problem.reason;
                activated => {
                    Intents.retry-cooling(AppState.workspace.id);
                }
            }
        }

        StyledText {
            text: root.problem.detail;
            style: Theme.text.value;
            color: Theme.color.ink-muted;
            wrap: word-wrap;
            accessible-role: none;
        }

        if root.problem.outcome != "": StyledText {
            text: root.problem.outcome;
            style: Theme.text.value;
            color: Theme.color.danger;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: "Outcome";
            accessible-value: root.problem.outcome;
        }
    }
}

// One chart: the grid, the series (over its area, if it has one), its limits and its label.
component ChartPane inherits Rectangle {
    in property <ChartView> chart;

    // The path commands for `part`, at this chart's size.
    pure function path(part: ChartPart) -> string {
        AppState.chart-path(root.chart.id, part, root.width / 1px, root.height / 1px, Theme.stroke.dash / 1px, Theme.stroke.dash-gap / 1px, AppState.revision)
    }
    property <string> series: path(ChartPart.series);
    property <string> area: root.chart.area ? path(ChartPart.area) : "";
    property <string> limit: root.chart.limit ? path(ChartPart.limit) : "";
    property <string> enforced-limit: root.chart.enforced-limit ? path(ChartPart.enforced-limit) : "";
    property <string> pending-limit: root.chart.pending-limit ? path(ChartPart.pending-limit) : "";

    Grid { }

    if root.area != "": Area {
        commands: root.area;
    }
    if root.series != "": Series {
        commands: root.series;
    }
    // The enforced limit's dashes go under the configured limit, which hides them where they meet.
    if root.enforced-limit != "": LimitLine {
        commands: root.enforced-limit;
    }
    // While a limit is pending, the one in effect steps back and the pending one is in the accent.
    if root.limit != "": LimitLine {
        commands: root.limit;
        ink: root.pending-limit != "" ? Theme.color.ink-muted : Theme.color.accent;
    }
    if root.pending-limit != "": LimitLine {
        commands: root.pending-limit;
    }

    // The limit's line, which a drag moves to stage a new limit where it's let go.
    if root.chart.draggable: limit-handle := TouchArea {
        y: root.height * root.chart.handle-y - self.height / 2;
        height: Theme.size.limit-grab;
        mouse-cursor: ns-resize;
        moved => {
            if self.pressed {
                Intents.drag-power-limit((self.y + self.mouse-y) / root.height);
            }
        }
    }

    if root.chart.label != "": StyledText {
        x: Theme.space.xs;
        y: Theme.space.xxs;
        height: self.preferred-height;
        text: root.chart.label;
        style: Theme.text.label;
        color: Theme.color.ink-muted;
        accessible-role: none;
    }
}

// One of the fan curve's points, drawn as a square at its temperature and speed in an editor
// `area-width` by `area-height`. Dragging it moves it, and so do the arrow keys while it has focus:
// ← and → by 1 °C, ↑ and ↓ by 1% (×5 with Shift); Tab moves on to the next point. Read-only, it
// still takes focus, so the keyboard reaches it and why it's read-only.
component CurveHandle inherits Rectangle {
    in property <CurvePointView> point;
    in property <int> index;
    in property <length> area-width;
    in property <length> area-height;
    in property <bool> pending;
    in property <bool> read-only;
    in property <string> reason;
    in property <int> minimum;
    in property <int> maximum;
    property <bool> keyboard-focus;

    // Moves the point by `temperature-by` °C and `speed-by` %, unless it's read-only.
    function move(temperature-by: int, speed-by: int) {
        if !root.read-only {
            Intents.move-curve-point(root.index, temperature-by, speed-by);
        }
    }

    accessible-role: slider;
    accessible-label: point.label;
    accessible-value: point.value-text;
    accessible-value-minimum: minimum;
    accessible-value-maximum: maximum;
    accessible-value-step: 1;
    accessible-read-only: read-only;
    accessible-description: read-only ? reason : "";
    accessible-action-increment => {
        move(0, 1);
    }
    accessible-action-decrement => {
        move(0, -1);
    }
    forward-focus: keys;
    x: root.area-width * root.point.x - self.width / 2;
    y: root.area-height * root.point.y - self.height / 2;
    width: Theme.size.curve-grab;
    height: Theme.size.curve-grab;

    keys := FocusScope {
        focus-gained(reason) => {
            root.keyboard-focus = reason == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard-focus = false;
        }
        key-pressed(event) => {
            let by = event.modifiers.shift ? 5 : 1;
            if event.text == Key.LeftArrow {
                move(-by, 0);
                return accept;
            }
            if event.text == Key.RightArrow {
                move(by, 0);
                return accept;
            }
            if event.text == Key.UpArrow {
                move(0, by);
                return accept;
            }
            if event.text == Key.DownArrow {
                move(0, -by);
                return accept;
            }
            reject
        }

        TouchArea {
            mouse-cursor: root.read-only ? MouseCursor.default : MouseCursor.move;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    keys.focus();
                }
            }
            moved => {
                if self.pressed && !root.read-only {
                    Intents.drag-curve-point(root.index, (root.x + self.mouse-x) / root.area-width, (root.y + self.mouse-y) / root.area-height);
                }
            }
        }
    }

    Rectangle {
        width: Theme.size.curve-point;
        height: Theme.size.curve-point;
        background: Theme.color.surface;
        border-width: Theme.stroke.limit;
        border-color: root.point.faulty ? Theme.color.danger : root.pending ? Theme.color.accent : Theme.color.series;
    }

    if keyboard-focus: Rectangle {
        border-width: Theme.stroke.focus;
        border-color: Theme.color.ink;
    }
}

// The fan curve editor: temperature across and requested fan speed up, with the curve in effect,
// any pending curve over it in the accent, the temperature a curve must reach full speed by, and
// a live marker at the GPU's temperature and fan speed now, which it also says above the curve.
// The temperature axis's ends are under it, then what keeps the pending curve from being
// applied.
component FanCurve inherits Rectangle {
    in property <FanCurveView> curve;

    accessible-role: groupbox;
    accessible-label: "Fan curve";

    // Spaced so a point at 0% or 100%, drawn half outside the plot, clears the lines around it.
    VerticalLayout {
        spacing: Theme.space.s;

        HorizontalLayout {
            spacing: Theme.space.s;

            StyledText {
                horizontal-stretch: 1;
                text: "CURVE";
                style: Theme.text.label;
                color: Theme.color.ink-muted;
                accessible-role: none;
            }

            if root.curve.has-marker: StyledText {
                text: root.curve.marker-text;
                style: Theme.text.value;
                color: Theme.color.ink-muted;
                accessible-role: text;
                accessible-label: "Temperature and fan speed now";
                accessible-value: root.curve.marker-text;
            }
        }

        plot := Rectangle {
            vertical-stretch: 1;

            // The path commands for `part`, at the plot's size.
            pure function path(part: CurvePart) -> string {
                AppState.curve-path(part, plot.width / 1px, plot.height / 1px, AppState.revision)
            }
            property <string> in-effect: root.curve.in-effect ? path(CurvePart.in-effect) : "";
            property <string> pending: root.curve.pending ? path(CurvePart.pending) : "";

            Grid { }

            if root.curve.has-full-speed: Rectangle {
                x: parent.width * root.curve.full-speed-x;
                width: Theme.stroke.hairline;
                background: Theme.color.ink-muted;
            }

            if root.curve.has-marker: Rectangle {
                x: parent.width * root.curve.marker-x;
                width: Theme.stroke.hairline;
                background: Theme.color.rule;
            }

            // While a curve is pending, the one in effect steps back.
            if plot.in-effect != "": CurveLine {
                commands: plot.in-effect;
                ink: root.curve.pending ? Theme.color.ink-muted : Theme.color.series;
            }
            if plot.pending != "": CurveLine {
                commands: plot.pending;
                ink: Theme.color.accent;
            }

            if root.curve.has-marker: marker := Rectangle {
                x: parent.width * root.curve.marker-x - self.width / 2;
                y: parent.height * root.curve.marker-y - self.height / 2;
                width: Theme.size.curve-marker;
                height: Theme.size.curve-marker;
                border-radius: self.width / 2;
                background: Theme.color.ink;
                border-width: Theme.stroke.hairline;
                border-color: Theme.color.surface;
            }

            for point[index] in root.curve.points: CurveHandle {
                point: point;
                index: index;
                area-width: plot.width;
                area-height: plot.height;
                pending: root.curve.pending;
                read-only: root.curve.read-only;
                reason: root.curve.reason;
                minimum: root.curve.speed-minimum;
                maximum: root.curve.speed-maximum;
            }
        }

        HorizontalLayout {
            StyledText {
                horizontal-stretch: 1;
                text: root.curve.temperature-from;
                style: Theme.text.value;
                color: Theme.color.ink-muted;
                accessible-role: none;
            }

            StyledText {
                text: root.curve.temperature-to;
                style: Theme.text.value;
                color: Theme.color.ink-muted;
                accessible-role: none;
            }
        }

        if root.curve.problems != "": StyledText {
            text: root.curve.problems;
            style: Theme.text.value;
            color: Theme.color.danger;
            overflow: elide;
            accessible-role: text;
            accessible-label: "Fan curve problems";
            accessible-value: root.curve.problems;
        }
    }
}

// The marker and word that collapse the fan curve editor, or open it again.
component CurveToggle inherits Rectangle {
    in property <bool> open;

    accessible-role: button;
    accessible-label: "Fan curve editor";
    accessible-expandable: true;
    accessible-expanded: open;
    accessible-action-default => {
        Intents.toggle-fan-curve();
    }
    forward-focus: press;
    width: row.preferred-width + 2 * Theme.space.xs;
    background: press.has-hover ? Theme.color.hover : transparent;

    press := PressArea {
        activated => {
            Intents.toggle-fan-curve();
        }
    }

    row := HorizontalLayout {
        x: Theme.space.xs;
        spacing: Theme.space.xs;

        DisclosureMarker {
            y: (parent.height - self.height) / 2;
            open: root.open;
        }

        StyledText {
            text: "CURVE";
            style: Theme.text.label;
            color: press.has-hover ? Theme.color.ink : Theme.color.ink-muted;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// A full-width track: the label, a large readout and its details on the left, the live charts in
// the middle, and max/avg/min over the range on the right. The Fans track's open fan curve editor
// goes before its charts, and why Prism stopped following its fan curve goes across its bottom; a
// `narrow` track drops max/avg/min, and the editor takes its charts' place. A `short` track gets
// shorter.
export component Track inherits Rectangle {
    in property <TrackView> track;
    in property <bool> narrow;
    in property <bool> short;
    property <bool> shows-fan-curve: root.track.has-fan-curve && root.track.fan-curve.open;
    property <length> head-padding: root.short ? Theme.space.xs : Theme.space.m;

    accessible-role: groupbox;
    accessible-label: track.name;
    min-height: max(root.short ? Theme.size.track-min-short : Theme.size.track-min, head.min-height) + problem.min-height;
    preferred-height: max(root.shows-fan-curve ? Theme.size.track-curve : Theme.size.track, head.preferred-height) + problem.preferred-height;
    vertical-stretch: 1;

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            Rectangle {
                width: Theme.size.track-head;

                head := VerticalLayout {
                    padding-top: root.head-padding;
                    padding-bottom: root.head-padding;
                    padding-left: Theme.space.xxl;
                    padding-right: Theme.space.xxl;
                    spacing: root.short ? Theme.space.xxs : Theme.space.xs;
                    alignment: start;

                    HorizontalLayout {
                        StyledText {
                            horizontal-stretch: 1;
                            text: root.track.label;
                            style: Theme.text.label;
                            color: Theme.color.ink-muted;
                            vertical-alignment: center;
                            accessible-role: none;
                        }

                        if root.track.has-fan-curve: CurveToggle {
                            open: root.track.fan-curve.open;
                        }
                    }

                    // The fan picker sits beside the readout, so it takes no line of its own.
                    HorizontalLayout {
                        spacing: Theme.space.m;

                        Rectangle {
                            horizontal-stretch: 1;
                            accessible-role: text;
                            accessible-label: root.track.readout-label;
                            accessible-value: root.track.readout.spoken;
                            accessible-description: root.track.unknown-reason;
                            height: readout.preferred-height;

                            readout := HorizontalLayout {
                                alignment: start;
                                spacing: Theme.space.m;

                                HorizontalLayout {
                                    StyledText {
                                        text: root.track.readout.value;
                                        style: Theme.text.readout;
                                        vertical-alignment: bottom;
                                        accessible-role: none;
                                    }

                                    if root.track.readout.known: StyledText {
                                        text: root.track.readout.suffix;
                                        style: Theme.text.readout-unit;
                                        color: Theme.color.ink-muted;
                                        vertical-alignment: bottom;
                                        accessible-role: none;
                                    }
                                }

                                // Why the reading is unknown, beside its dash.
                                if root.track.unknown-reason != "": StyledText {
                                    horizontal-stretch: 1;
                                    text: root.track.unknown-reason;
                                    style: Theme.text.value;
                                    color: Theme.color.ink-muted;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    accessible-role: none;
                                }
                            }
                        }

                        if root.track.has-fan-mode && root.track.fan-mode.has-arrangement: VerticalLayout {
                            alignment: end;

                            FanPicker {
                                fan-mode: root.track.fan-mode;
                                compact: true;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: root.short ? 0 : Theme.space.xxs;

                        if root.track.has-fan-mode: FanMode {
                            fan-mode: root.track.fan-mode;
                            short: root.short;
                        }

                        // Tuning values are tuned in place with their steppers. With a fixed speed,
                        // every fan is asked for the same speed, so a short track shows it in place of
                        // each fan's; with a fan curve, every fan follows it, and its live marker
                        // shows their speed.
                        for detail in root.track.details: VerticalLayout {
                            if detail.has-stepper: TuningDetail {
                                detail: detail;
                                short: root.short;
                            }
                            if !detail.has-stepper && !(root.short && (root.track.fan-mode.has-fixed-speed || root.shows-fan-curve)): Detail {
                                detail: detail;
                            }
                        }
                    }
                }

                VerticalDivider {
                    x: parent.width - self.width;
                }
            }

            HorizontalLayout {
                padding-top: Theme.space.s;
                padding-bottom: Theme.space.s;
                padding-left: Theme.space.m;
                padding-right: Theme.space.m;
                spacing: Theme.space.m;

                if root.shows-fan-curve: FanCurve {
                    horizontal-stretch: 1;
                    curve: root.track.fan-curve;
                }
                if !(root.narrow && root.shows-fan-curve): HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.space.m;

                    for chart in root.track.charts: ChartPane {
                        horizontal-stretch: 1;
                        chart: chart;
                    }
                }
            }

            if !root.narrow: Rectangle {
                width: Theme.size.stats;

                VerticalDivider {
                    x: 0;
                }

                VerticalLayout {
                    padding-top: Theme.space.m;
                    padding-bottom: Theme.space.m;
                    padding-left: Theme.space.l;
                    padding-right: Theme.space.m;
                    spacing: Theme.space.xxs;
                    alignment: start;

                    // The range the statistics cover; the range picker says it to a screen reader.
                    StyledText {
                        text: root.track.range;
                        style: Theme.text.value;
                        color: Theme.color.ink-muted;
                        accessible-role: none;
                    }

                    Statistic {
                        name: "max";
                        label: root.track.max-label;
                        readout: root.track.max;
                    }

                    Statistic {
                        name: "avg";
                        label: root.track.avg-label;
                        readout: root.track.avg;
                    }

                    Statistic {
                        name: "min";
                        label: root.track.min-label;
                        readout: root.track.min;
                    }
                }
            }
        }

        problem := VerticalLayout {
            vertical-stretch: 0;

            if root.track.has-fan-mode && root.track.fan-mode.has-problem: CoolingProblem {
                problem: root.track.fan-mode.problem;
            }
        }
    }

    Divider {
        y: parent.height - self.height;
    }
}
