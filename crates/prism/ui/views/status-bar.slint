import { Theme } from "../theme.slint";
import { PressArea, StyledText } from "../widgets.slint";
import { AppState, Intents, SettingsSection } from "../state.slint";

// The prismd connection, such as "PRISMD · NOT RUNNING", which opens Settings → Daemon.
component ConnectionItem inherits Rectangle {
    accessible-role: button;
    accessible-label: AppState.connection;
    accessible-description: "Opens Settings → Daemon";
    accessible-action-default => {
        Intents.go-to-settings(SettingsSection.daemon);
    }
    forward-focus: press;
    width: item.preferred-width + 2 * Theme.space.xs;
    background: press.has-hover ? Theme.color.chrome-hover : transparent;

    press := PressArea {
        ring-color: Theme.color.chrome-ink;
        activated => {
            Intents.go-to-settings(SettingsSection.daemon);
        }
    }

    item := HorizontalLayout {
        x: Theme.space.xs;
        spacing: Theme.space.s;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: Theme.size.status-dot;
                height: Theme.size.status-dot;
                background: AppState.connected ? Theme.color.ok : Theme.color.chrome-ink-muted;
            }
        }

        StyledText {
            text: AppState.connection;
            style: Theme.text.status;
            color: press.has-hover ? Theme.color.chrome-ink : Theme.color.chrome-ink-muted;
            accessible-role: none;
        }
    }
}

// The status bar: the prismd connection, then where telemetry comes from.
export component StatusBar inherits Rectangle {
    height: Theme.size.status-bar;
    background: Theme.color.chrome;

    HorizontalLayout {
        padding-left: Theme.space.xl - Theme.space.xs;
        padding-right: Theme.space.xl;
        spacing: Theme.space.xxl;

        ConnectionItem {
            horizontal-stretch: 0;
        }

        StyledText {
            text: AppState.telemetry;
            style: Theme.text.status;
            color: Theme.color.chrome-ink-muted;
        }

        Rectangle {
            horizontal-stretch: 1;
        }
    }
}
