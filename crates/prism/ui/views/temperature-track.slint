import { Theme } from "../theme.slint";
import { Divider, Grid, Series, StyledText, VerticalDivider } from "../widgets.slint";
import { AppState, ReadoutView, TemperatureTrackView } from "../state.slint";

component Statistic inherits Rectangle {
    in property <string> name;
    in property <string> label;
    in property <ReadoutView> readout;

    accessible-role: text;
    accessible-label: label;
    accessible-value: readout.spoken;
    height: row.preferred-height;

    row := HorizontalLayout {
        alignment: start;
        spacing: Theme.space.s;

        StyledText {
            text: root.name;
            style: Theme.text.value;
            color: Theme.color.ink-muted;
            accessible-role: none;
        }

        StyledText {
            text: root.readout.text;
            style: Theme.text.value;
            accessible-role: none;
        }
    }
}

// The Temperature track: the current reading, a live chart, and max/avg/min over the range.
export component TemperatureTrack inherits Rectangle {
    in property <TemperatureTrackView> track;

    height: Theme.size.track;
    accessible-role: groupbox;
    accessible-label: "Temperature";

    HorizontalLayout {
        Rectangle {
            width: Theme.size.track-head;

            VerticalLayout {
                padding-top: Theme.space.m;
                padding-bottom: Theme.space.m;
                padding-left: Theme.space.xxl;
                padding-right: Theme.space.xxl;
                spacing: Theme.space.xs;
                alignment: start;

                StyledText {
                    text: "TEMPERATURE";
                    style: Theme.text.label;
                    color: Theme.color.ink-muted;
                    accessible-role: none;
                }

                Rectangle {
                    accessible-role: text;
                    accessible-label: "Temperature reading";
                    accessible-value: root.track.readout.spoken;
                    accessible-description: root.track.unknown-reason;
                    height: readout.preferred-height;

                    readout := HorizontalLayout {
                        alignment: start;

                        StyledText {
                            text: root.track.readout.value;
                            style: Theme.text.readout;
                            vertical-alignment: bottom;
                            accessible-role: none;
                        }

                        if root.track.readout.known: StyledText {
                            text: " " + root.track.readout.unit;
                            style: Theme.text.readout-unit;
                            color: Theme.color.ink-muted;
                            vertical-alignment: bottom;
                            accessible-role: none;
                        }
                    }
                }

                if root.track.unknown-reason != "": StyledText {
                    text: root.track.unknown-reason;
                    style: Theme.text.value;
                    color: Theme.color.ink-muted;
                    wrap: word-wrap;
                    overflow: elide;
                    accessible-role: none;
                }
            }

            VerticalDivider {
                x: parent.width - self.width;
            }
        }

        HorizontalLayout {
            padding-top: Theme.space.s;
            padding-bottom: Theme.space.s;
            padding-left: Theme.space.m;
            padding-right: Theme.space.m;

            chart := Rectangle {
                horizontal-stretch: 1;
                property <string> series: AppState.temperature-series(self.width / 1px, self.height / 1px, AppState.revision);

                Grid { }

                if chart.series != "": Series {
                    commands: chart.series;
                }
            }
        }

        Rectangle {
            width: Theme.size.stats;

            VerticalDivider {
                x: 0;
            }

            VerticalLayout {
                padding-top: Theme.space.m;
                padding-bottom: Theme.space.m;
                padding-left: Theme.space.l;
                padding-right: Theme.space.m;
                spacing: Theme.space.xxs;
                alignment: start;

                StyledText {
                    text: root.track.range;
                    style: Theme.text.value;
                    color: Theme.color.ink-muted;
                    accessible-label: "Range";
                    accessible-value: root.track.range;
                }

                Statistic {
                    name: "max";
                    label: "Maximum temperature";
                    readout: root.track.max;
                }

                Statistic {
                    name: "avg";
                    label: "Average temperature";
                    readout: root.track.avg;
                }

                Statistic {
                    name: "min";
                    label: "Minimum temperature";
                    readout: root.track.min;
                }
            }
        }
    }

    Divider {
        y: parent.height - self.height;
    }
}
