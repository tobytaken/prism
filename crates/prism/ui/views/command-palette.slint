import { Theme } from "../theme.slint";
import { Divider, PopupSurface, PressArea, StyledText } from "../widgets.slint";
import { AppState, Intents, PaletteEntryView } from "../state.slint";

// A key of a shortcut, drawn as a key cap. It carries no accessible role; the command it belongs
// to says its shortcut in its description. It stays here until a second screen needs one, such as
// a tooltip (ADR 0009).
component Kbd inherits Rectangle {
    in property <string> text;

    min-width: Theme.size.kbd;
    height: Theme.size.kbd;
    border-width: Theme.stroke.hairline;
    border-color: Theme.color.rule;
    background: Theme.color.surface;
    accessible-role: none;

    HorizontalLayout {
        padding-left: Theme.space.xs;
        padding-right: Theme.space.xs;

        StyledText {
            text: root.text;
            style: Theme.text.value;
            color: Theme.color.ink-muted;
            horizontal-alignment: center;
            accessible-role: none;
        }
    }
}

// A single-line text field. It keeps the keys it edits with: the window's global shortcuts that
// clash with text editing don't fire while a text field has focus (see `Intents.key-pressed`).
// It stays here until a second screen needs one (ADR 0009).
component TextField inherits Rectangle {
    // What the field is for, as a screen reader says it.
    in property <string> label;
    in property <string> placeholder;
    callback edited(text: string);
    // Return was pressed.
    callback accepted();
    // Keys the field sees before editing with them, such as ↑ and ↓ in a list it filters.
    callback key-pressed(event: KeyEvent) -> EventResult;

    forward-focus: input;
    height: Theme.size.text-field;
    background: Theme.color.surface;
    border-width: Theme.stroke.hairline;
    border-color: input.has-focus ? Theme.color.ink : Theme.color.rule;

    if input.text == "": StyledText {
        x: Theme.space.l;
        width: parent.width - 2 * Theme.space.l;
        text: root.placeholder;
        style: Theme.text.body;
        color: Theme.color.ink-muted;
        overflow: elide;
        accessible-role: none;
    }

    input := TextInput {
        x: Theme.space.l;
        width: parent.width - 2 * Theme.space.l;
        single-line: true;
        vertical-alignment: center;
        font-family: Theme.text.body.family;
        font-size: Theme.text.body.size;
        font-weight: Theme.text.body.weight;
        color: Theme.color.ink;
        selection-background-color: Theme.color.hover;
        selection-foreground-color: Theme.color.ink;
        accessible-label: root.label;
        accessible-placeholder-text: root.placeholder;
        edited => {
            root.edited(self.text);
        }
        accepted => {
            root.accepted();
        }
        key-pressed(event) => {
            root.key-pressed(event)
        }
    }
}

// A command in the palette: its title, why it can't run when it can't (dimmed), and its shortcut.
component PaletteRow inherits Rectangle {
    in property <PaletteEntryView> entry;
    callback activated();

    height: Theme.size.palette-row;
    accessible-role: list-item;
    accessible-label: entry.title;
    accessible-description: entry.description;
    accessible-enabled: entry.available;
    accessible-item-selectable: true;
    accessible-item-selected: entry.highlighted;
    accessible-action-default => {
        root.activated();
    }
    background: entry.highlighted ? Theme.color.hover : transparent;

    press := PressArea {
        // Choosing a row runs it at once, so the palette's field keeps the focus.
        focus-on-click: false;
        activated => {
            root.activated();
        }
    }

    if entry.highlighted: Rectangle {
        x: 0;
        width: Theme.stroke.selection;
        background: Theme.color.accent;
    }

    HorizontalLayout {
        padding-left: Theme.space.xl;
        padding-right: Theme.space.xl;
        spacing: Theme.space.m;

        StyledText {
            text: entry.title;
            style: Theme.text.body;
            color: entry.available ? Theme.color.ink : Theme.color.ink-muted;
            overflow: elide;
            accessible-role: none;
        }

        if !entry.available: StyledText {
            text: entry.reason;
            style: Theme.text.value;
            color: Theme.color.ink-muted;
            accessible-role: none;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        HorizontalLayout {
            alignment: end;
            spacing: Theme.space.xxs;
            padding-top: (Theme.size.palette-row - Theme.size.kbd) / 2;
            padding-bottom: (Theme.size.palette-row - Theme.size.kbd) / 2;

            for key in entry.keys: Kbd {
                text: key;
            }
        }
    }
}

// The command palette (Ctrl+K): a field that fuzzy-filters the commands below it. ↑ and ↓ move
// the highlight, Return runs the highlighted command, and Escape or a click outside closes it.
export component CommandPalette inherits Rectangle {
    // Clicks outside the palette close it.
    TouchArea {
        clicked => {
            Intents.dismiss();
        }
    }

    PopupSurface {
        x: (parent.width - self.width) / 2;
        y: Theme.size.palette-top;
        width: Theme.size.palette-width;
        height: layout.preferred-height;
        accessible-role: groupbox;
        accessible-label: "Command palette";

        // Clicks inside the palette stay there.
        TouchArea { }

        layout := VerticalLayout {
            height: self.preferred-height;
            padding: Theme.space.m;
            spacing: Theme.space.m;

            field := TextField {
                label: "Command";
                placeholder: "Type a command";
                init => {
                    self.focus();
                }
                edited(query) => {
                    Intents.filter-palette(query);
                }
                accepted => {
                    Intents.run-highlighted();
                }
                key-pressed(event) => {
                    if event.text == Key.UpArrow {
                        Intents.highlight-previous();
                        return accept;
                    }
                    if event.text == Key.DownArrow {
                        Intents.highlight-next();
                        return accept;
                    }
                    reject
                }
            }

            Divider { }

            Rectangle {
                accessible-role: list;
                accessible-label: "Commands";
                height: entries.preferred-height;

                entries := VerticalLayout {
                    for entry[index] in AppState.palette-entries: PaletteRow {
                        entry: entry;
                        activated => {
                            Intents.run-palette-entry(index);
                        }
                    }

                    if AppState.palette-entries.length == 0: StyledText {
                        height: Theme.size.palette-row;
                        x: Theme.space.xl;
                        text: "No matching commands";
                        style: Theme.text.body;
                        color: Theme.color.ink-muted;
                    }
                }
            }
        }
    }
}
