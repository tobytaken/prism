// Prism's state and the user's intents, implemented in Rust. The glue copies the prism-ui core's
// view models in here after every input; views only lay out and draw what they're given.

import { SegmentView } from "widgets/segmented.slint";
import { MenuEntryView } from "widgets/menu.slint";

// A reading as shown. `value` is the number or "—", `suffix` what follows it, such as " °C" or "%",
// `text` both together, and `spoken` what a screen reader says.
export struct ReadoutView {
    value: string,
    unit: string,
    suffix: string,
    known: bool,
    text: string,
    spoken: string,
}

export struct SidebarGpuView {
    id: string,
    index: string,
    name: string,
    identity: string,
    label: string,
    temperature: ReadoutView,
    utilization: ReadoutView,
    power-draw: ReadoutView,
    fan-speed: ReadoutView,
    vitals: string,
    paused: bool,
    selected: bool,
}

export struct ExplainedStateView {
    title: string,
    reason: string,
    hint: string,
}

// How a limit is drawn across a chart, and keyed next to its value.
export enum LimitMark { none, solid, dashed }

// A setting a stepper stages; `fan-speed` is the fixed speed every fan shares.
export enum TuningSetting { power-limit, graphics-offset, memory-offset, fan-speed }

// A tuning value's stepper: `label` as a screen reader says it, `value` the one it steps from and
// `value-text` how it's said, `text` the value in effect as shown, `pending` such as "→ 450 W" or
// "→ default" while one is staged, and `reason` why it's read-only, when it is.
// `can-use-default` says whether Use default, called `default-label` for a screen reader, can
// stage the default; `failure` says the last Apply didn't put the pending value into effect, and
// why.
export struct StepperView {
    setting: TuningSetting,
    label: string,
    value: int,
    value-text: string,
    minimum: int,
    maximum: int,
    step: int,
    text: string,
    pending: string,
    read-only: bool,
    reason: string,
    can-use-default: bool,
    default-label: string,
    failure: string,
}

// A current value under a track's readout, such as the power limit: `label` as shown, `name` as a
// screen reader says it, and `unknown-reason` why it's unknown, when it is. A tuning value has a
// stepper that tunes it in place.
export struct DetailView {
    label: string,
    name: string,
    readout: ReadoutView,
    unknown-reason: string,
    mark: LimitMark,
    has-stepper: bool,
    stepper: StepperView,
}

// Each chart a track can draw, for the chart-path callback.
export enum ChartId { temperature, utilization, power-draw, graphics-clock, memory-clock, fan-speed }

// The parts of a chart Rust draws as path commands.
export enum ChartPart { series, area, limit, enforced-limit, pending-limit }

// One of a track's charts: what tells it apart from the track's other chart, if anything, whether
// it fills the area under its series, and which limits it draws.
// `draggable` says whether the limit's line can be dragged to stage a new limit, which then draws
// as `pending-limit`; `handle-y` is where its line is, from the top (0) to the bottom (1).
export struct ChartView {
    id: ChartId,
    label: string,
    area: bool,
    limit: bool,
    enforced-limit: bool,
    pending-limit: bool,
    draggable: bool,
    handle-y: float,
}

// Why Prism stopped following a GPU's fan curve: its title and why, how its fans fell back and
// what brings the curve back as `detail`, and its button `action` ("Retry" or "Resume"), which can
// be pressed when `available` and says why not in `reason`. `outcome` says why prismd didn't apply
// the latest one.
export struct CoolingProblemView {
    title: string,
    detail: string,
    action: string,
    available: bool,
    reason: string,
    outcome: string,
}

// The fan control mode of every fan of the GPU, or of the fan picked while each has its own
// settings: automatic cooling, a fixed speed or a fan curve as segments, with the mode pending next
// to them, such as "→ fixed", `failure` when the last Apply didn't put it into effect, and why it's
// read-only, when it is. `note` is what the user should know about the GPU's cooling, such as why
// fan curves are unavailable, and `has-fixed-speed` whether the track's details have the fixed
// speed's stepper. `mode` is the mode picked as shown, such as "Auto", and `mode-text` as a screen
// reader says it.
// With more than one fan, `has-arrangement` says whether `fans` picks every fan together or one
// fan for the controls to set, with a change between one shared configuration and per-fan settings
// pending next to it as `arrangement-pending`, such as "→ per fan". `can-recall` says whether the
// remembered fan curve can be recalled into the draft now.
// `has-problem` says whether Prism stopped following the GPU's fan curve, as `problem` explains.
export struct FanModeView {
    modes: [SegmentView],
    mode: string,
    mode-text: string,
    has-fixed-speed: bool,
    pending: string,
    failure: string,
    read-only: bool,
    reason: string,
    note: string,
    has-arrangement: bool,
    arrangement-pending: string,
    fans: [SegmentView],
    can-recall: bool,
    has-problem: bool,
    problem: CoolingProblemView,
}

// One of the fan curve's points: where it's drawn, from the left (0) to the right (1) and from the
// top (0) to the bottom (1), what a screen reader calls it and says of it, such as "65% at
// 65 °C", and whether one of the pending curve's problems is with it.
export struct CurvePointView {
    label: string,
    value-text: string,
    x: float,
    y: float,
    faulty: bool,
}

// The parts of the fan curve editor Rust draws as path commands: the curve in effect, and the
// pending one over it.
export enum CurvePart { in-effect, pending }

// The fan curve editor: whether it's open, its points and whether they're a pending curve's, and
// whether a curve in effect is drawn. The temperature axis runs from `temperature-from` on the
// left to `temperature-to` on the right, and speeds from 0% at the bottom to 100% at the top;
// `full-speed-x` is where across a curve must reach full speed by, when `has-full-speed`.
// `marker-x` and `marker-y` are where the GPU's temperature and fan speed are now, which
// `marker-text` says, when `has-marker`. `problems` says what keeps the pending curve from being
// applied, and `reason` why the points can't be moved, when `read-only`. A point's speed is
// between `speed-minimum` and `speed-maximum`.
export struct FanCurveView {
    open: bool,
    points: [CurvePointView],
    pending: bool,
    in-effect: bool,
    temperature-from: string,
    temperature-to: string,
    has-full-speed: bool,
    full-speed-x: float,
    has-marker: bool,
    marker-x: float,
    marker-y: float,
    marker-text: string,
    problems: string,
    read-only: bool,
    reason: string,
    speed-minimum: int,
    speed-maximum: int,
}

// A track: its name, readout and details, its charts, and the max/avg/min of its metric over the
// range, each with what a screen reader calls it. `has-fan-mode` says whether it has the fan
// control mode, and `has-fan-curve` whether it has the fan curve editor.
export struct TrackView {
    name: string,
    label: string,
    readout: ReadoutView,
    readout-label: string,
    unknown-reason: string,
    details: [DetailView],
    charts: [ChartView],
    range: string,
    max: ReadoutView,
    avg: ReadoutView,
    min: ReadoutView,
    max-label: string,
    avg-label: string,
    min-label: string,
    has-fan-mode: bool,
    fan-mode: FanModeView,
    has-fan-curve: bool,
    fan-curve: FanCurveView,
}

// The fixed change strip under the workspace's header: its summary, whether there are unapplied
// changes, what the last Apply applied and left, and whether Apply and Discard can run and why
// not.
export struct ChangeStripView {
    summary: string,
    pending: bool,
    outcome: string,
    // What changed under the changes that needs a review before Apply replaces it; Apply becomes
    // Review while it's there.
    review: string,
    can-apply: bool,
    apply-reason: string,
    can-discard: bool,
    discard-reason: string,
}

// What drives automatic switching on a GPU, or why it doesn't, in short as `summary` and explained
// as `detail`. `failed` says it's in a failure pause, which Retry ends; Retry can be pressed when
// `can-retry` and says why not in `retry-reason`. `resumable` says Resume ends what holds it, an
// automatic switching pause or a manual override, so its button resumes instead of pausing; the
// button can be pressed when `can-pause` and says why not in `pause-reason`. `outcome` says why prismd refused the latest
// Pause, Resume or Retry.
export struct SwitchingView {
    summary: string,
    detail: string,
    failed: bool,
    resumable: bool,
    can-pause: bool,
    pause-reason: string,
    can-retry: bool,
    retry-reason: string,
    outcome: string,
}

// `no-tuning-access` is why there's no tuning access, and empty with it. `has-profiles` says
// whether the header shows the GPU's profiles, read-only with `profiles-reason` when
// `profiles-read-only`, showing `current-profile`, the current profile's name, or "None".
// `profiles-not-saved` says whether the values in effect differ from the current profile.
// `reveal-fans` changes each time the tracks should scroll the Fans track into view.
// `has-switching` says whether the GPU's automatic switching status is known, as `switching`.
export struct WorkspaceView {
    id: string,
    title: string,
    subtitle: string,
    has-profiles: bool,
    profiles-read-only: bool,
    profiles-reason: string,
    current-profile: string,
    profiles-not-saved: bool,
    changes: ChangeStripView,
    no-tuning-access: string,
    has-switching: bool,
    switching: SwitchingView,
    hardware-open: bool,
    reveal-fans: int,
}

// Which dialog is over the window, if any.
export enum DialogKind {
    none,
    review,
    confirm-close,
    discard-for-profile,
    profile-corrections,
    profile-name,
    delete-profile,
    manage-profiles,
    add-steam-game,
    add-program,
    run-driver-plan,
    reboot,
}

// A dialog over the window: its title and message, and whether its Apply and Discard can run and
// why not. A profile dialog has a name to start its field from, what's wrong with it or why
// prismd refused it as `error`, and its confirmation, titled `confirm-text`, which can run when
// `can-confirm` and says why not in `confirm-reason`; Manage profiles uses `confirm-reason` for
// why no profile can be renamed or deleted. Add Steam game and Add program have their search as
// `name`, what their list waits for or why it's empty as `status`, and why the last one chosen
// couldn't be added as `error`; Add program's Browse can run when `can-confirm`.
export struct DialogView {
    kind: DialogKind,
    title: string,
    message: string,
    name: string,
    error: string,
    confirm-text: string,
    can-confirm: bool,
    confirm-reason: string,
    // A review's Apply, such as "Apply again".
    apply-text: string,
    can-apply: bool,
    apply-reason: string,
    can-discard: bool,
    discard-reason: string,
    status: string,
}

// The Games section, apart from its games: whether automatic switching is known and on, why
// nothing can be changed (`read-only`, with the reason), why running games can't be recognized,
// why prismd refused the latest change, each empty when there's nothing to say, and what the list
// says while it has no games.
export struct GamesView {
    switching-known: bool,
    automatic-switching: bool,
    read-only: bool,
    reason: string,
    recognition-problem: string,
    outcome: string,
    empty: string,
}

// A game's link to at most one of the caller's profiles of a GPU: the group's label, such as
// "Dota 2 on GPU 0 · RTX 5090 · 01:00.0", the GPU, the linked profile's name or "None", and None
// then the GPU's profiles as segments, the linked one picked.
export struct GameLinkView {
    label: string,
    gpu: string,
    linked: string,
    choices: [SegmentView],
}

// One of the caller's games: its name, what it is, such as "Steam app 570 · Not installed", and
// its link on each GPU here.
export struct GameView {
    name: string,
    detail: string,
    links: [GameLinkView],
}

// One of the caller's Steam apps in Add Steam game, and why it can't be added, when it can't.
export struct SteamAppView {
    name: string,
    available: bool,
    reason: string,
}

// One of the caller's running programs in Add program: its name, its host location or that it's
// unknown, why prismd may not recognize it by that location, and why it can't be added, when it
// can't.
export struct ProgramView {
    name: string,
    detail: string,
    warning: string,
    available: bool,
    reason: string,
}

// A current tuning value a review says changed: the setting, from what to what, and what the
// draft stages for it, such as "Yours: 450 W", if anything.
export struct ReviewChangeView {
    name: string,
    change: string,
    yours: string,
}

// One of the GPU's profiles in Manage profiles: its name, and whether it's the current or the
// startup profile, such as "Current profile · Startup profile".
export struct ManagedProfileView {
    name: string,
    marks: string,
}

// A command in the palette. `keys` are its shortcut's keys, `reason` why it can't run when it
// can't, and `description` both as a screen reader says them.
export struct PaletteEntryView {
    title: string,
    keys: [string],
    available: bool,
    reason: string,
    description: string,
    highlighted: bool,
}

// A key press, for the window's global shortcuts.
export struct KeyPress {
    text: string,
    control: bool,
    shift: bool,
    alt: bool,
    meta: bool,
}

export enum Section { games, drivers, settings }

export enum SettingsSection { appearance, startup, notifications, daemon, about }

export enum ServiceAction { enable, restart }

// A labeled fact about the prismd connection, such as the socket path.
export struct FactView {
    label: string,
    value: string,
}

// Settings → Daemon, apart from its lists. `has-action` says whether there's a button for
// `action`, titled `action-title` and not pressable while `action-busy`; `error` is why the last
// one failed, and empty otherwise.
export struct DaemonView {
    title: string,
    has-action: bool,
    action: ServiceAction,
    action-title: string,
    action-busy: bool,
    error: string,
}

// A problem or an event in Activity: its title, its lines, how long ago it happened, and both as
// a screen reader adds them to the title (`spoken`). `has-action` says whether it has a button,
// titled `action-title`, and `action-reason` why it can't be pressed, when it can't.
export struct ActivityItemView {
    title: string,
    detail: string,
    when: string,
    spoken: string,
    has-action: bool,
    action-title: string,
    action-available: bool,
    action-reason: string,
}

// Drivers, apart from its lists: why nothing can run (`read-only`, with the reason), what it says in
// place of the host's driver status, and why prismd refused the latest request, each empty when
// there's nothing to say. The recommended driver plan, when there is one, with whether Run can
// open its confirmation and why not; the latest driver job, when there is one, with its state, the
// step running while it's active, what its state means, and whether Cancel and Reboot can run and
// why not. Reboot shows only while the job left the host needing a restart.
export struct DriversView {
    read-only: bool,
    reason: string,
    status: string,
    outcome: string,
    has-plan: bool,
    plan-title: string,
    can-run: bool,
    run-reason: string,
    has-job: bool,
    job-title: string,
    job-state: string,
    job-active: bool,
    job-step: string,
    job-explanation: string,
    can-cancel: bool,
    cancel-reason: string,
    reboot: bool,
    can-reboot: bool,
    reboot-reason: string,
}

// Activity's lists: current problems, startup outcomes and recent events.
export enum ActivityList { problems, startup, recent }

export enum ContentKind { searching, no-gpus, gpu, games, drivers, settings }

export global AppState {
    in property <[SidebarGpuView]> gpus;
    in property <ContentKind> content;
    in property <ExplainedStateView> no-gpus;
    in property <WorkspaceView> workspace;
    // The workspace's tracks, top to bottom, and its range picker's segments.
    in property <[TrackView]> tracks;
    in property <[SegmentView]> ranges;
    // The header's profile buttons: the GPU's profiles, the current one picked and the startup
    // one marked.
    in property <[SegmentView]> profiles;
    // The hardware details: the GPU inventory's entry for the GPU, and its control capabilities.
    in property <[FactView]> hardware-inventory;
    in property <[FactView]> hardware-capabilities;
    // The prismd connection item: what it says, and whether there is a session.
    in property <string> connection;
    in property <bool> connected;
    in property <string> telemetry;
    // What drives automatic switching on the selected GPU, or why it doesn't, such as
    // "AUTO · CYBERPUNK 2077 → QUIET"; empty without a session.
    in property <string> switching;
    // Whether any GPU has unapplied tuning changes, which hold automatic changes.
    in property <bool> edit-hold;
    // The problem indicator: how many current problems there are, and what it says.
    in property <int> problems;
    in property <string> problem-indicator;
    // Activity, while it's open: its lists, why prismd refused the latest action, and what it
    // says while it lists nothing, each empty when there's nothing to say.
    in property <bool> activity-open;
    in property <[ActivityItemView]> activity-problems;
    in property <[ActivityItemView]> activity-startup;
    in property <[ActivityItemView]> activity-recent;
    in property <string> activity-outcome;
    in property <string> activity-empty;
    in property <SettingsSection> settings-section;
    // The open section's name, such as "Appearance".
    in property <string> settings-section-name;
    in property <DaemonView> daemon;
    // Settings → Daemon's paragraphs, commands to copy and facts, in order.
    in property <[string]> daemon-paragraphs;
    in property <[string]> daemon-commands;
    in property <[FactView]> daemon-facts;
    in property <bool> palette-open;
    in property <DialogView> dialog;
    // The current tuning values the open review says changed, or the profile values the
    // correction review would adjust.
    in property <[ReviewChangeView]> review-changes;
    // The commands matching the palette's query, recently run ones first.
    in property <[PaletteEntryView]> palette-entries;
    // The workspace header's `⋯` profile menu, while it's open.
    in property <bool> profile-menu-open;
    in property <[MenuEntryView]> profile-menu;
    // The GPU's profiles Manage profiles lists.
    in property <[ManagedProfileView]> managed-profiles;
    // The Games section, its games, the Steam apps Add Steam game lists and the running programs
    // Add program lists.
    in property <GamesView> games-section;
    in property <[GameView]> games;
    in property <[SteamAppView]> steam-apps;
    in property <[ProgramView]> programs;
    // Drivers, the host's facts and warnings, the recommended driver plan's blockers, warnings and
    // what's left after it, and the driver job's log, oldest first.
    in property <DriversView> drivers;
    in property <[FactView]> driver-facts;
    in property <[string]> driver-warnings;
    in property <[string]> plan-blockers;
    in property <[string]> plan-warnings;
    in property <[string]> plan-steps;
    in property <[string]> driver-log;
    // The open Run or Reboot confirmation's lines, such as the plan's warnings.
    in property <[string]> dialog-details;
    // Changes with every input, so derived geometry knows when to redraw.
    in property <int> revision;

    // A part of one of the selected GPU's charts as path commands for a chart of this size, with
    // dashes and gaps this long where the part is dashed.
    pure callback chart-path(chart: ChartId, part: ChartPart, width: float, height: float, dash: float, gap: float, revision: int) -> string;
    // A part of the selected GPU's fan curve editor as path commands for an editor of this size.
    pure callback curve-path(part: CurvePart, width: float, height: float, revision: int) -> string;
}

export global Intents {
    callback select-gpu(id: string);
    callback go-to(section: Section);
    callback go-to-settings(section: SettingsSection);
    // Asks systemd to enable or restart prismd.
    callback run-service(action: ServiceAction);
    // Puts `text` on the clipboard.
    callback copy(text: string);
    callback minimize-window();
    callback toggle-maximized();
    callback close-window();
    callback filter-palette(query: string);
    callback highlight-next();
    callback highlight-previous();
    callback run-highlighted();
    callback run-palette-entry(index: int);
    // Closes the topmost overlay.
    callback dismiss();
    // Shows the range at this index among the range picker's segments.
    callback show-range(index: int);
    callback toggle-hardware-details();
    // Stages this value for the selected GPU's setting, or the setting's default.
    callback stage(setting: TuningSetting, value: int);
    callback use-default(setting: TuningSetting);
    // Stages the fan control mode at this index among the fan control mode's segments.
    callback stage-fan-mode(index: int);
    // Picks the fans at this index among the fan picker's segments: every fan, then each fan.
    callback pick-fans(index: int);
    // Stages the selected GPU's remembered fan curve, with its fan arrangement.
    callback recall-remembered-curve();
    // Applies the suspended cooling configuration of the GPU, by id, again: Retry or Resume.
    callback retry-cooling(gpu-id: string);
    // Stages the power limit drawn at `y` on the power chart, from the top (0) to the bottom (1).
    callback drag-power-limit(y: float);
    // Stages the fan curve with this point moved to where it's drawn at `x` across and `y` down
    // the editor, from 0 to 1, or moved by this many °C and %.
    callback drag-curve-point(point: int, x: float, y: float);
    callback move-curve-point(point: int, temperature-by: int, speed-by: int);
    // Collapses the fan curve editor, or opens it again.
    callback toggle-fan-curve();
    // Applies the profile at this index among the header's profile buttons.
    callback apply-profile(index: int);
    // Answers the open profile dialog: discards the GPU's unapplied changes and applies the
    // profile, adjusts the profile and applies it, saves or renames it under the name typed, or
    // deletes it.
    callback confirm-profile();
    // Opens the `⋯` profile menu, or closes it again, and runs its entry at this index.
    callback toggle-profile-menu();
    callback run-profile-menu-entry(index: int);
    // The open profile dialog's name now reads `name`.
    callback edit-profile-name(name: string);
    // Renames or deletes the profile at this index in Manage profiles.
    callback rename-profile(index: int);
    callback delete-profile(index: int);
    // Turns automatic switching on or off.
    callback set-automatic-switching(enabled: bool);
    // Pauses or resumes automatic switching on the GPU, by id.
    callback set-switching-paused(gpu-id: string, paused: bool);
    // Retries automatic switching on the GPU, by id, ending its failure pause.
    callback retry-switching(gpu-id: string);
    // Links the game at this index, on the GPU of its link at this index, to the choice at this
    // index: None, then the GPU's profiles.
    callback link-game(game: int, link: int, choice: int);
    // Removes the game at this index.
    callback remove-game(game: int);
    // Opens Add Steam game, searches it for `query`, and adds the app at this index in its list.
    callback add-steam-game();
    callback filter-steam-apps(query: string);
    callback add-steam-app(index: int);
    // Opens Add program, searches it for `query`, adds the running program at this index in its
    // list, and opens the file chooser for a program file to add.
    callback add-program();
    callback filter-programs(query: string);
    callback add-running-program(index: int);
    callback browse-for-program();
    // Asks before running the recommended driver plan, cancels the active driver job, asks before
    // restarting the host, and answers the open Run or Reboot confirmation.
    callback run-driver-plan();
    callback cancel-driver-job();
    callback reboot-host();
    callback confirm-driver-dialog();
    // Applies or discards the selected GPU's unapplied tuning changes.
    callback apply-changes();
    callback discard-changes();
    // Closes Prism, dropping every GPU's unapplied tuning changes.
    callback discard-and-close();
    // Opens Activity.
    callback open-activity();
    // Does what the button of the item at this index in one of Activity's lists does.
    callback run-activity-action(list: ActivityList, index: int);
    // Runs the global shortcut `key` presses, if any, and says whether the key was spoken for. While
    // a text field has focus, a shortcut that clashes with text editing is spoken for but doesn't
    // run.
    callback key-pressed(key: KeyPress, in-text-field: bool) -> bool;
}

// Where the `⋯` profile menu opens: under the button that opened it, right-aligned to it, in
// window coordinates.
export global MenuAnchor {
    in-out property <length> right;
    in-out property <length> top;
}

// Wakes the UI thread after a worker thread has posted inputs for the core.
export global Inbox {
    callback inputs-posted();
}
