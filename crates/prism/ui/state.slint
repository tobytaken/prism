// Prism's state and the user's intents, implemented in Rust. The glue copies the prism-ui core's
// view models in here after every input; views only lay out and draw what they're given.

import { SegmentView } from "widgets/segmented.slint";

// A reading as shown. `value` is the number or "—", `text` the value with its unit, and `spoken`
// what a screen reader says.
export struct ReadoutView {
    value: string,
    unit: string,
    known: bool,
    text: string,
    spoken: string,
}

export struct SidebarGpuView {
    id: string,
    index: string,
    name: string,
    identity: string,
    label: string,
    temperature: ReadoutView,
    utilization: ReadoutView,
    power-draw: ReadoutView,
    fan-speed: ReadoutView,
    vitals: string,
    selected: bool,
}

export struct ExplainedStateView {
    title: string,
    reason: string,
    hint: string,
}

// How a limit is drawn across a chart, and keyed next to its value.
export enum LimitMark { none, solid, dashed }

// A current value under a track's readout, such as the power limit: `label` as shown, `name` as a
// screen reader says it, and `unknown-reason` why it's unknown, when it is.
export struct DetailView {
    label: string,
    name: string,
    readout: ReadoutView,
    unknown-reason: string,
    mark: LimitMark,
}

// Each chart a track can draw, for the chart-path callback.
export enum ChartId { temperature, utilization, power-draw, graphics-clock, memory-clock, fan-speed }

// The parts of a chart Rust draws as path commands.
export enum ChartPart { series, area, limit, enforced-limit }

// One of a track's charts: what tells it apart from the track's other chart, if anything, whether
// it fills the area under its series, and which limits it draws.
export struct ChartView {
    id: ChartId,
    label: string,
    area: bool,
    limit: bool,
    enforced-limit: bool,
}

// A track: its name, readout and details, its charts, and the max/avg/min of its metric over the
// range, each with what a screen reader calls it.
export struct TrackView {
    name: string,
    label: string,
    readout: ReadoutView,
    readout-label: string,
    unknown-reason: string,
    details: [DetailView],
    charts: [ChartView],
    range: string,
    max: ReadoutView,
    avg: ReadoutView,
    min: ReadoutView,
    max-label: string,
    avg-label: string,
    min-label: string,
}

// `no-tuning-access` is why there's no tuning access, and empty with it.
export struct WorkspaceView {
    id: string,
    title: string,
    subtitle: string,
    no-tuning-access: string,
    hardware-open: bool,
}

// A command in the palette. `keys` are its shortcut's keys, `reason` why it can't run when it
// can't, and `description` both as a screen reader says them.
export struct PaletteEntryView {
    title: string,
    keys: [string],
    available: bool,
    reason: string,
    description: string,
    highlighted: bool,
}

// A key press, for the window's global shortcuts.
export struct KeyPress {
    text: string,
    control: bool,
    shift: bool,
    alt: bool,
    meta: bool,
}

export enum Section { games, drivers, settings }

export enum SettingsSection { appearance, startup, notifications, daemon, about }

export enum ServiceAction { enable, restart }

// A labeled fact about the prismd connection, such as the socket path.
export struct FactView {
    label: string,
    value: string,
}

// Settings → Daemon, apart from its lists. `has-action` says whether there's a button for
// `action`, titled `action-title` and not pressable while `action-busy`; `error` is why the last
// one failed, and empty otherwise.
export struct DaemonView {
    title: string,
    has-action: bool,
    action: ServiceAction,
    action-title: string,
    action-busy: bool,
    error: string,
}

export enum ContentKind { searching, no-gpus, gpu, games, drivers, settings }

export global AppState {
    in property <[SidebarGpuView]> gpus;
    in property <ContentKind> content;
    in property <ExplainedStateView> no-gpus;
    in property <WorkspaceView> workspace;
    // The workspace's tracks, top to bottom, and its range picker's segments.
    in property <[TrackView]> tracks;
    in property <[SegmentView]> ranges;
    // The hardware details: the GPU inventory's entry for the GPU, and its control capabilities.
    in property <[FactView]> hardware-inventory;
    in property <[FactView]> hardware-capabilities;
    // The prismd connection item: what it says, and whether there is a session.
    in property <string> connection;
    in property <bool> connected;
    in property <string> telemetry;
    in property <SettingsSection> settings-section;
    // The open section's name, such as "Appearance".
    in property <string> settings-section-name;
    in property <DaemonView> daemon;
    // Settings → Daemon's paragraphs, commands to copy and facts, in order.
    in property <[string]> daemon-paragraphs;
    in property <[string]> daemon-commands;
    in property <[FactView]> daemon-facts;
    in property <bool> palette-open;
    // The commands matching the palette's query, recently run ones first.
    in property <[PaletteEntryView]> palette-entries;
    // Changes with every input, so derived geometry knows when to redraw.
    in property <int> revision;

    // A part of one of the selected GPU's charts as path commands for a chart of this size, with
    // dashes and gaps this long where the part is dashed.
    pure callback chart-path(chart: ChartId, part: ChartPart, width: float, height: float, dash: float, gap: float, revision: int) -> string;
}

export global Intents {
    callback select-gpu(id: string);
    callback go-to(section: Section);
    callback go-to-settings(section: SettingsSection);
    // Asks systemd to enable or restart prismd.
    callback run-service(action: ServiceAction);
    // Puts `text` on the clipboard.
    callback copy(text: string);
    callback minimize-window();
    callback toggle-maximized();
    callback close-window();
    callback filter-palette(query: string);
    callback highlight-next();
    callback highlight-previous();
    callback run-highlighted();
    callback run-palette-entry(index: int);
    // Closes the topmost overlay.
    callback dismiss();
    // Shows the range at this index among the range picker's segments.
    callback show-range(index: int);
    callback toggle-hardware-details();
    // Runs the global shortcut `key` presses, if any, and says whether the key was spoken for. While
    // a text field has focus, a shortcut that clashes with text editing is spoken for but doesn't
    // run.
    callback key-pressed(key: KeyPress, in-text-field: bool) -> bool;
}

// Wakes the UI thread after a worker thread has posted inputs for the core.
export global Inbox {
    callback inputs-posted();
}
