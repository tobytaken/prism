{
  "name": "prism-electron",
  "productName": "Prism Electron",
  "version": "0.1.0",
  "description": "Linux-only Electron + Rust desktop app for inspecting and configuring NVIDIA GPUs.",
  "main": ".vite/build/main.js",
  "private": true,
  "packageManager": "bun@1.2.15",
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "test": "vitest run --config vite.renderer.config.ts",
    "test:watch": "vitest --config vite.renderer.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts,.tsx .",
    "build:sidecar:debug": "cargo build --manifest-path rust/Cargo.toml --bin prism_backend",
    "build:sidecar:release": "cargo build --manifest-path rust/Cargo.toml --release --bin prism_backend",
    "build:daemon:release": "cargo build --manifest-path rust/Cargo.toml --release --bin prismd",
    "package": "bun run build:sidecar:release && electron-forge package",
    "make": "bun run build:sidecar:release && electron-forge make",
    "package:gui:deb": "bun run build:sidecar:release && electron-forge make --targets=@electron-forge/maker-deb",
    "package:gui:rpm": "bun run build:sidecar:release && electron-forge make --targets=@electron-forge/maker-rpm",
    "package:gui:flatpak": "bun run build:sidecar:release && electron-forge make --targets=@electron-forge/maker-flatpak",
    "package:daemon:deb": "bash scripts/package-prismd-deb.sh",
    "package:daemon:rpm": "bash scripts/package-prismd-rpm.sh"
  },
  "author": {
    "name": "Tobias Steinhaeusler"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.99.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.14.1",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-flatpak": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/plugin-electronegativity": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "electron": "41.2.1",
    "eslint": "^9.34.0",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.4"
  }
}
